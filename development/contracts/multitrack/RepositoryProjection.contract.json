{
  "schema_version": "clued.multitrack-repository-projection-contract/1",
  "contract_id": "CLUED-MULTITRACK-REPOSITORY-PROJECTION-CONTRACT-v0.1-20260916",
  "status": "IMPLEMENTATION_CONTRACT_CANDIDATE",
  "authority_effect": "NONE",
  "purpose": "Validate a repository-side, read-only projection of a Clued Current Governance Inventory / Priority Snapshot without creating a second Canonical Store.",
  "canonical_boundary": {
    "online_canonical_store": "authenticated Clued service backed by Supabase",
    "repository_projection_authority": false,
    "business_write_target": false,
    "reverse_write": "FORBIDDEN"
  },
  "required_projection": {
    "schema_version": "clued.multitrack-repository-projection/1",
    "authority_effect": "NONE",
    "writeback": "FORBIDDEN",
    "projection_status_must_include": [
      "NOT_AUTHORITY",
      "NOT_FROZEN"
    ],
    "track_ids": [
      "E",
      "P",
      "R",
      "B"
    ],
    "item_id_pattern": "^[EPRB]-[0-9]{3}$",
    "allowed_status_marks": {
      "COMPLETED": "✅",
      "IN_PROGRESS": "◐",
      "READY": "○",
      "VERIFYING": "🔎",
      "WAITING": "⏳",
      "BLOCKED": "⛔",
      "DEFERRED": "↘",
      "NOT_STARTED": "☐"
    },
    "allowed_evidence_grades": [
      "A",
      "B",
      "C",
      "D",
      "X"
    ],
    "stable_priority_item_ids_required": true,
    "all_frontier_item_ids_must_resolve": true,
    "all_item_like_dependency_refs_must_resolve": true,
    "hard_identity_conflicts_must_resolve_to_X_grade_items": true,
    "reconciliation_total_items_must_equal_item_count": true
  },
  "source_binding": {
    "expected_snapshot_id": "CLUED-CURRENT-PRIORITY-SNAPSHOT-v0.1.3-SOURCE-BOUND-20260912",
    "expected_inventory_id": "CLUED-CURRENT-GOVERNANCE-INVENTORY-v0.1.3-SOURCE-BOUND-20260912",
    "expected_source_file_sha256": "bca8fd9244657beabe09a3f815295e09d5207b4709f11ab8722d9a8d58491f5f",
    "expected_source_generated_at_date": "2026-09-12",
    "source_connector_local_ids_must_not_be_committed": true
  },
  "projection_outputs": {
    "machine": "development/projections/multitrack/CurrentGovernanceInventory.projection.json",
    "human": "development/projections/multitrack/CurrentGovernanceInventory.projection.md",
    "validator": "scripts/governance/validate_multitrack_projection.py"
  },
  "promotion_rule": "A passing repository validator proves projection integrity only. It does not freeze the inventory, resolve Canonical Currentness, grant execution authority, or authorize production actions."
}
