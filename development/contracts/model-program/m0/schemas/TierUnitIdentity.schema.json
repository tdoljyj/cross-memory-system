{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TierUnitIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_separator",
    "parts",
    "canonicalization",
    "task_id"
  ],
  "properties": {
    "domain_separator": {
      "const": "clued:model:tier-unit:v1"
    },
    "parts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "canonicalization": {
      "const": "NFC_UTF8_JCS_SHA256"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
