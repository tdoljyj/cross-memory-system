{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentAuthorizationProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "stage_id",
    "authority_ref",
    "environment",
    "training_allowed",
    "real_model_evaluation_allowed",
    "production_allowed",
    "budget",
    "attempts",
    "deadline",
    "stop_conditions"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "const": "MODEL-PROGRAM-M0"
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "const": "NON_PRODUCTION"
    },
    "training_allowed": {
      "const": false
    },
    "real_model_evaluation_allowed": {
      "const": false
    },
    "production_allowed": {
      "const": false
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_seconds",
        "max_compute_bytes",
        "max_cost_microunits"
      ],
      "properties": {
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_compute_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_microunits": {
          "const": 0
        }
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "deadline": {
      "type": "string",
      "minLength": 1
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
