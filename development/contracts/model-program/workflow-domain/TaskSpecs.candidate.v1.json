      "definition": {
        "candidate_tie_break": "Apply the definitions in the listed order only when their conditions are satisfied; otherwise abstain. This is a proposed single-label convention, not official adjudication.",
        "comparison_direction": "RIGHT_CONTENT_RELATIVE_TO_LEFT_CONTENT",
        "content_only_relation_candidates": [
          {
            "excludes": "Does not establish actual withdrawal, currentness or the actor's authority.",
            "meaning": "The right content explicitly proposes or describes withdrawing the left item, with the referenced item resolved in the permitted input.",
            "proposed_label": "WITHDRAWAL_INTENT_CANDIDATE"
          },
          {
            "excludes": "Does not establish approved supersession, activation or a valid version transition.",
            "meaning": "The right content explicitly proposes or describes replacing the left item, with the referenced predecessor resolved in the input.",
            "proposed_label": "REPLACEMENT_INTENT_CANDIDATE"
          },
          {
            "excludes": "Unknown or ambiguous dates/conditions require abstention instead of invented applicability.",
            "meaning": "The contents address the same subject but differ under explicit non-overlapping time, conditions or applicability; direct equivalence/conflict would ignore that distinction.",
            "proposed_label": "CONDITIONAL_COMPARISON_CANDIDATE"
          },
          {
            "excludes": "Does not choose a true side or resolve the conflict officially.",
            "meaning": "The visible contents make incompatible propositions about the same entity/property under overlapping applicability, without an earlier intent/condition category applying.",
            "proposed_label": "CONFLICT_CANDIDATE"
          },
          {
            "excludes": "Semantic equivalence does not imply equal approval, permissions, evidence strength or canonical identity.",
            "meaning": "Both contents express the same propositions and material qualifiers for this comparison, with no extra independent content.",
            "proposed_label": "EQUIVALENT_CONTENT"
          },
          {
            "excludes": "A changed or contradictory constraint is not a refinement merely because it is more detailed.",
            "meaning": "The right content narrows or specifies the left proposition compatibly, without an independent added proposition or prior category applying.",
            "proposed_label": "REFINEMENT_CANDIDATE"
          },
          {
            "excludes": "Co-occurrence alone is not sufficient support for compatibility or shared subject.",
            "meaning": "The right content adds related compatible propositions beyond the left, without a prior intent, condition, conflict, equivalence or refinement category applying.",
            "proposed_label": "SUPPLEMENT_CANDIDATE"
          },
          {
            "excludes": "Insufficient permitted evidence or uncertain interpretation is abstention, not automatically unrelated.",
            "meaning": "Sufficient permitted evidence positively establishes that the two contents concern unrelated subjects/propositions under the bound task definition.",
            "proposed_label": "UNRELATED_CONTENT"
          }
        ],
        "formal_authority_state_model_output": "FORBIDDEN",
        "must_abstain_if": [
          "Missing permitted evidence",
          "Unresolved subject/direction",
          "Ambiguous required time/conditions",
          "Incompatible interpretations cannot be discriminated",
          "Actual relationship definition is not adopted or current"
        ]
      },
