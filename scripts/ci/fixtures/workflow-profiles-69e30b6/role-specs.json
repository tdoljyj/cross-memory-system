                  "uses": "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683",
                  "with": {
                    "ref": "${{ github.event.pull_request.head.sha || github.ref }}",
                    "persist-credentials": false
                  }
                },
                {
                  "uses": "actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020",
                  "with": {
                    "node-version": "24.19.0"
                  }
                },
                {
                  "name": "Configure job temporary storage",
                  "uses": "./.github/actions/ci-temporary-storage"
                },
                {
                  "name": "Bounded idle process to prove real provider cancellation",
                  "run": "if [ \"$GITHUB_EVENT_NAME\" = pull_request ]; then\n  node scripts/ci/clued-handover-external-source-check.mjs --candidate-check\nelse\n  sleep 2400\nfi\n"
                }
              ]
            }
          }
        ]
      }
    }
