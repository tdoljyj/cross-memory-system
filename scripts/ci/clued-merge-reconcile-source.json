{
  "schema": "clued.merge-reconcile-source/1",
  "repository": "tdoljyj/cross-memory-system",
  "defaultBranch": "main",
  "baseCommit": "75ed720d45fa84ed3455246b9d082ec99c146d60",
  "executionAuthority": false,
  "dispatchAuthority": false,
  "productionAuthority": false,
  "runnerHookException": false,
  "hostQualification": "separate_required",
  "workflow": {
    "path": ".github/workflows/clued-merge-reconcile.yml",
    "sha256": "11d4b72a9f330801bdb44d3bd8a5b6c411cd328b02a6946ab9ada7485ec7dbf3"
  },
  "role": {
    "id": "reconcile",
    "definition": {
      "if": "github.ref == 'refs/heads/main'",
      "name": "clued-merge-reconcile",
      "runs-on": [
        "self-hosted",
        "Windows",
        "X64",
        "clued-controller-windows-v1",
        "trust-internal"
      ],
      "timeout-minutes": 10,
      "environment": "clued-admission",
      "concurrency": {
        "group": "clued-merge-executor",
        "cancel-in-progress": false
      },
      "steps": [
        {
          "uses": "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683",
          "with": {
            "ref": "main",
            "persist-credentials": false
          }
        },
        {
          "uses": "actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020",
          "with": {
            "node-version": "22"
          }
        },
        {
          "name": "Configure job temporary storage",
          "uses": "./.github/actions/ci-temporary-storage"
        },
        {
          "name": "Verify the exact reconciliation Source before loading operation credentials",
          "run": "node scripts/ci/clued-merge-reconcile-source.mjs"
        },
        {
          "name": "Re-observe the queue and use the original guarded operations",
          "env": {
            "CLUED_CONTEXT_READ_TOKEN": "${{ secrets.CLUED_ADMISSION_CLUED_TOKEN }}",
            "CLUED_ADMISSION_APP_ID": "${{ secrets.CLUED_ADMISSION_APP_ID }}",
            "CLUED_ADMISSION_APP_PRIVATE_KEY": "${{ secrets.CLUED_ADMISSION_APP_KEY }}",
            "CLUED_MERGE_ADMISSION_STATE": "${{ vars.CLUED_MERGE_ADMISSION_STATE }}",
            "GITHUB_TOKEN": "${{ github.token }}"
          },
          "run": "node scripts/ci/clued-merge-reconcile.mjs"
        }
      ]
    },
    "sha256": "66f0ab7a81fb3e6c6465d19434dde50474f30907a34593f3f0a2ed45121a2a9f"
  }
}
