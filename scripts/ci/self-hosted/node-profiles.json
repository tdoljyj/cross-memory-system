{
  "schema": "clued.self-hosted-node-profiles/v1",
  "repository": "tdoljyj/cross-memory-system",
  "runner_package": {
    "version": "2.337.0",
    "windows_x64_sha256": "1150692afa94e71f872017e254ea55b6eece1eece3fe7e3a6d4c93d0a1b85cfc",
    "linux_x64_sha256": "70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613",
    "auto_update_after_registration": true
  },
  "runner_profiles": {
    "windows-general-v1": {
      "os": "Windows",
      "arch": "X64",
      "required_custom_labels": [
        "clued",
        "pool-general",
        "trust-internal",
        "cap-python312"
      ],
      "optional_custom_labels": [
        "cap-node24"
      ],
      "runtime_contract": {
        "git": "required",
        "python": "3.12",
        "node": "24 when cap-node24 is advertised"
      },
      "execution": {
        "startup": "windows-service",
        "service_account": "clued-runner",
        "watchdog": "supervises WSL and the Linux runners only; never starts the Windows runner"
      }
    },
    "linux-docker-wsl2-v1": {
      "os": "Linux",
      "arch": "X64",
      "required_custom_labels": [
        "clued",
        "pool-general",
        "trust-internal",
        "Linux",
        "cap-docker-linux",
        "runtime-wsl2"
      ],
      "optional_custom_labels": [],
      "runtime_contract": {
        "git": "required",
        "systemd": "required",
        "docker": "native Linux engine required",
        "docker_group_access": "required for runner user"
      },
      "execution": {
        "startup": "systemd",
        "wsl_keepalive": true
      }
    }
  },
  "capacity_profiles": {
    "compact-v1": {
      "description": "16 GB-class personal host; preserve foreground responsiveness.",
      "minimum_host_memory_gb": 12,
      "wsl_memory_gb": 6,
      "wsl_processors": 3,
      "wsl_swap_gb": 2,
      "watchdog_interval_seconds": 30,
      "suspend_free_memory_gb": 1.5,
      "resume_free_memory_gb": 2.5,
      "suspend_c_free_gb": 15,
      "resume_c_free_gb": 20,
      "suspend_runner_disk_free_gb": 40,
      "resume_runner_disk_free_gb": 55
    },
    "workstation-v1": {
      "description": "64 GB-class workstation; allow heavier parallel CI while preserving host headroom.",
      "minimum_host_memory_gb": 48,
      "wsl_memory_gb": 28,
      "wsl_processors": 16,
      "wsl_swap_gb": 8,
      "watchdog_interval_seconds": 60,
      "suspend_free_memory_gb": 6.0,
      "resume_free_memory_gb": 10.0,
      "suspend_c_free_gb": 15,
      "resume_c_free_gb": 20,
      "suspend_runner_disk_free_gb": 15,
      "resume_runner_disk_free_gb": 20
    }
  },
  "lifecycle_states": [
    "planned",
    "enrolling",
    "validated",
    "active",
    "draining",
    "maintenance",
    "retired"
  ],
  "hosts": [
    {
      "host_id": "company-primary",
