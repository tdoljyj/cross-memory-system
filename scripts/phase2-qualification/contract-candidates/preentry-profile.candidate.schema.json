{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pre-entry Profile candidate",
  "$comment": "CANDIDATE_NOT_ACTIVATED. NO_AUTHORITY_EFFECT. Original QualificationPhasePolicy is a design model, not acceptance. gate_refs preserve S06 L3435. Permission for N/A is optional, never default, and needs actual accepted Schema verification outside this shape validator.",
  "type": "object",
  "required": [
    "profile_id",
    "definition_version",
    "purpose",
    "allowed_environments",
    "allowed_subject_kinds",
    "allowed_candidate_states",
    "required_stages",
    "candidate_must_differ_from_controller",
    "required_true",
    "required_false",
    "gate_control_type",
    "terminal_receipt_control_type",
    "gate_refs",
    "gate_definition_set_digest",
    "max_lifetime_seconds"
  ],
  "properties": {
    "profile_id": {
      "const": "DP-PREENTRY-SKILL-QUALIFICATION"
    },
    "definition_version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "const": "SKILL_COEXISTENCE_QUALIFICATION"
    },
    "allowed_environments": {
      "type": "array",
      "items": {
        "enum": [
          "ISOLATED_TEST"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 1
    },
    "allowed_subject_kinds": {
      "type": "array",
      "items": {
        "enum": [
          "ISOLATED_TEST_SUBJECT"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 1
    },
    "allowed_candidate_states": {
      "type": "array",
      "items": {
        "enum": [
          "UNQUALIFIED_QUARANTINED_TEST_SUBJECT_ONLY"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 1
    },
    "required_stages": {
      "type": "array",
      "items": {
        "enum": [
          "R05",
          "R06",
          "R07",
          "R08",
          "R09",
          "R10"
        ]
      },
      "uniqueItems": true,
      "minItems": 6,
      "maxItems": 6
    },
    "candidate_must_differ_from_controller": {
      "const": true
    },
    "required_true": {
      "type": "array",
      "items": {
        "enum": [
          "profile_accepted",
          "authority_chain_verified",
          "owner_or_delegate_verified",
          "phase_authorization_valid",
          "controller_qualification_valid",
          "isolated_host_proven",
          "scope_contained",
          "exact_digests_bound",
          "budget_reserved",
          "evidence_sink_durable",
          "stop_channel_ready",
          "revocation_fresh",
          "target_revision_matches",
          "no_credential_crossing",
          "pre_registered_expectations"
        ]
      },
      "uniqueItems": true,
      "minItems": 15,
      "maxItems": 15
    },
    "required_false": {
      "type": "array",
      "items": {
        "enum": [
          "real_user_payload",
          "production_credentials",
          "public_distribution",
          "economic_rights",
          "model_action",
          "scope_expansion",
          "candidate_pointer_write"
        ]
      },
      "uniqueItems": true,
      "minItems": 7,
      "maxItems": 7
    },
    "gate_control_type": {
      "const": "GateAuthorization"
    },
    "terminal_receipt_control_type": {
      "const": "GateResultReceipt"
    },
    "gate_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "definition_version",
          "content_digest"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "definition_version": {
            "type": "string",
            "minLength": 1
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "gate_definition_set_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "max_lifetime_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "not_applicable_layer_permissions": {
      "type": "object",
      "required": [],
      "properties": {
        "account": {
          "type": "object",
          "required": [
            "reason",
            "accepted_schema_ref"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "accepted_schema_ref": {
              "type": "object",
              "required": [
                "uri",
                "sha256"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false,
              "$comment": "Candidate reference encoding; shape never proves resolution, acceptance, currentness or authority."
            }
          },
          "additionalProperties": false
        },
        "integration_installation": {
          "type": "object",
          "required": [
            "reason",
            "accepted_schema_ref"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "accepted_schema_ref": {
              "type": "object",
              "required": [
                "uri",
                "sha256"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false,
              "$comment": "Candidate reference encoding; shape never proves resolution, acceptance, currentness or authority."
            }
          },
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "required": [
            "reason",
            "accepted_schema_ref"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "accepted_schema_ref": {
              "type": "object",
              "required": [
                "uri",
                "sha256"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false,
              "$comment": "Candidate reference encoding; shape never proves resolution, acceptance, currentness or authority."
            }
          },
          "additionalProperties": false
        },
        "binding": {
          "type": "object",
          "required": [
            "reason",
            "accepted_schema_ref"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "accepted_schema_ref": {
              "type": "object",
              "required": [
                "uri",
                "sha256"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false,
              "$comment": "Candidate reference encoding; shape never proves resolution, acceptance, currentness or authority."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
