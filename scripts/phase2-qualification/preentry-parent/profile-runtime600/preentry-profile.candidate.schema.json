{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pre-entry Profile candidate",
  "$comment": "Exact proposed DP-PREENTRY execution Profile successor. S06 L3435 Release Profile composition does not apply: gate_refs/set digest removed, not waived for actual GateAuthorization. Four-layer N/A only for exact fixed synthetic Skill-input scope accepted with this definition; external verified acceptance/current authority remains required.",
  "type": "object",
  "required": [
    "profile_id",
    "definition_version",
    "purpose",
    "allowed_environments",
    "allowed_subject_kinds",
    "allowed_candidate_states",
    "required_stages",
    "candidate_must_differ_from_controller",
    "required_true",
    "required_false",
    "gate_control_type",
    "terminal_receipt_control_type",
    "max_lifetime_seconds",
    "not_applicable_layer_permissions"
  ],
  "properties": {
    "profile_id": {
      "const": "DP-PREENTRY-SKILL-QUALIFICATION"
    },
    "definition_version": {
      "const": "fixed-synthetic-skill-input-20260908.v3-runtime600"
    },
    "purpose": {
      "const": "SKILL_COEXISTENCE_QUALIFICATION"
    },
    "allowed_environments": {
      "type": "array",
      "items": {
        "enum": [
          "ISOLATED_TEST"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 1
    },
    "allowed_subject_kinds": {
      "type": "array",
      "items": {
        "enum": [
          "ISOLATED_TEST_SUBJECT"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 1
    },
    "allowed_candidate_states": {
      "type": "array",
      "items": {
        "enum": [
          "UNQUALIFIED_QUARANTINED_TEST_SUBJECT_ONLY"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 1
    },
    "required_stages": {
      "type": "array",
      "items": {
        "enum": [
          "R05",
          "R06",
          "R07",
          "R08",
          "R09",
          "R10"
        ]
      },
      "uniqueItems": true,
      "minItems": 6,
      "maxItems": 6
    },
    "candidate_must_differ_from_controller": {
      "const": true
    },
    "required_true": {
      "type": "array",
      "items": {
        "enum": [
          "profile_accepted",
          "authority_chain_verified",
          "owner_or_delegate_verified",
          "phase_authorization_valid",
          "controller_qualification_valid",
          "isolated_host_proven",
          "scope_contained",
          "exact_digests_bound",
          "budget_reserved",
          "evidence_sink_durable",
          "stop_channel_ready",
          "revocation_fresh",
          "target_revision_matches",
          "no_credential_crossing",
          "pre_registered_expectations"
        ]
      },
      "uniqueItems": true,
      "minItems": 15,
      "maxItems": 15
    },
    "required_false": {
      "type": "array",
      "items": {
        "enum": [
          "real_user_payload",
          "production_credentials",
          "public_distribution",
          "economic_rights",
          "model_action",
          "scope_expansion",
          "candidate_pointer_write"
        ]
      },
      "uniqueItems": true,
      "minItems": 7,
      "maxItems": 7
    },
    "gate_control_type": {
      "const": "GateAuthorization"
    },
    "terminal_receipt_control_type": {
      "const": "GateResultReceipt"
    },
    "max_lifetime_seconds": {
      "const": 600
    },
    "not_applicable_layer_permissions": {
      "type": "object",
      "required": [
        "account",
        "integration_installation",
        "context",
        "binding"
      ],
      "properties": {
        "account": {
          "type": "object",
          "required": [
            "reason",
            "accepted_schema_ref"
          ],
          "properties": {
            "reason": {
              "const": "该固定child没有Clued业务account、业务用户令牌或账户API；只读取明确三Skill文本和固定合成fixture。GitHub Owner控制身份仍存在并单独核验，不与此Clued业务account层混同。"
            },
            "accepted_schema_ref": {
              "type": "object",
              "required": [
                "uri",
                "sha256"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false,
              "$comment": "Candidate reference encoding; shape never proves resolution, acceptance, currentness or authority."
            }
          },
          "additionalProperties": false
        },
        "integration_installation": {
          "type": "object",
          "required": [
            "reason",
            "accepted_schema_ref"
          ],
          "properties": {
            "reason": {
              "const": "没有Clued集成安装实例、集成业务凭据或installation接口调用；宿主Docker安装及受信Git发布渠道不是本合成业务层installation，其控制/凭据代际继续独立核验。"
            },
            "accepted_schema_ref": {
              "type": "object",
              "required": [
                "uri",
                "sha256"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false,
              "$comment": "Candidate reference encoding; shape never proves resolution, acceptance, currentness or authority."
            }
          },
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "required": [
            "reason",
            "accepted_schema_ref"
          ],
          "properties": {
            "reason": {
              "const": "不创建或读取ContextStream/context/session业务对象；/allowed/fixture.json不是ContextStream或Canon。父监督会话session_generation不因此消失。"
            },
            "accepted_schema_ref": {
              "type": "object",
              "required": [
                "uri",
                "sha256"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false,
              "$comment": "Candidate reference encoding; shape never proves resolution, acceptance, currentness or authority."
            }
          },
          "additionalProperties": false
        },
        "binding": {
          "type": "object",
          "required": [
            "reason",
            "accepted_schema_ref"
          ],
          "properties": {
            "reason": {
              "const": "没有Clued Binding发行、选择、资源绑定或Binding token；纯固定文件挂载不是业务Binding。确切container/Skill/Scope/Root引用仍必须绑定且禁止改变。"
            },
            "accepted_schema_ref": {
              "type": "object",
              "required": [
                "uri",
                "sha256"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false,
              "$comment": "Candidate reference encoding; shape never proves resolution, acceptance, currentness or authority."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
