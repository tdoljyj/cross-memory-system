          "binding_epoch": {
            "const": "not_applicable"
          }
        },
        "required": [
          "binding_epoch"
        ]
      },
      "then": {
        "properties": {
          "binding_scope_ref": {
            "const": "not_applicable"
          },
          "not_applicable_evidence": {
            "required": [
              "binding"
            ]
          }
        },
        "required": [
          "not_applicable_evidence"
        ]
      },
      "else": {
        "properties": {
          "binding_scope_ref": {
            "not": {
              "const": "not_applicable"
            }
          },
          "not_applicable_evidence": {
            "not": {
              "required": [
                "binding"
              ]
            }
          }
        }
      }
    }
  ]
