      "const": "not_applicable"
    },
    "account_epoch": {
      "const": "not_applicable"
    },
    "integration_installation_scope_ref": {
      "const": "not_applicable"
    },
    "integration_installation_epoch": {
      "const": "not_applicable"
    },
    "context_scope_ref": {
      "const": "not_applicable"
    },
    "context_epoch": {
      "const": "not_applicable"
    },
    "binding_scope_ref": {
      "const": "not_applicable"
    },
    "binding_epoch": {
      "const": "not_applicable"
    }
  },
  "additionalProperties": false,
