+
+  permission-check:
+    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'permission_check'
+    name: Verify read-only workflow token cannot create a branch
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: read
+    steps:
+      - name: Check platform write permission using the read-only workflow token
+        env:
+          GH_TOKEN: ${{ github.token }}
+        shell: bash
+        run: |
+          python3 - <<'PY'
+          import json, os, urllib.request, urllib.error
+          repo = os.environ['GITHUB_REPOSITORY']
+          branch = 'phase2-permission-check-' + os.environ['GITHUB_RUN_ID']
+          endpoint = 'https://api.github.com/repos/' + repo + '/git/refs'
+          headers = {'Authorization': 'Bearer ' + os.environ['GH_TOKEN'],
+                     'Accept': 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28'}
+          payload = json.dumps({'ref':'refs/heads/' + branch, 'sha':os.environ['GITHUB_SHA']}).encode()
+          request = urllib.request.Request(endpoint, data=payload, headers=headers, method='POST')
+          try:
+              with urllib.request.urlopen(request, timeout=30) as response:
+                  status, body = response.status, json.load(response)
+          except urllib.error.HTTPError as error:
+              status, body = error.code, json.loads(error.read())
+          record = {'type':'ActualWorkflowTokenPermissionObservation', 'repository':repo,
+                    'source_commit':os.environ['GITHUB_SHA'], 'run_id':os.environ['GITHUB_RUN_ID'],
+                    'run_attempt':os.environ['GITHUB_RUN_ATTEMPT'], 'credential_class':'GitHub Actions token with contents:read',
+                    'operation':'Create a uniquely named temporary branch at this exact existing commit',
+                    'attempted_ref':'refs/heads/' + branch,
+                    'http_status':status, 'response_message':body.get('message'),
+                    'write_denied':status == 403 and body.get('message') == 'Resource not accessible by integration',
+                    'step18_pass':False, 'authority_effect':'NONE'}
+          with open('PermissionObservation.json', 'w') as stream:
+              json.dump(record, stream, indent=2)
+          if status == 201:
+              cleanup = urllib.request.Request(endpoint + '/heads/' + branch, headers=headers, method='DELETE')
+              try:
+                  with urllib.request.urlopen(cleanup, timeout=30) as response:
+                      record['unexpected_created_branch_cleanup_status'] = response.status
+              except urllib.error.HTTPError as error:
+                  record['unexpected_created_branch_cleanup_status'] = error.code
+              except (urllib.error.URLError, TimeoutError) as error:
+                  record['unexpected_created_branch_cleanup_status'] = 'UNKNOWN_NETWORK_ERROR'
+          with open('PermissionObservation.json', 'w') as stream:
+              json.dump(record, stream, indent=2)
+          print(json.dumps(record))
+          if not record['write_denied']:
+              raise SystemExit('Expected actual platform permission denial was not observed')
+          PY
+
+      - name: Retain actual permission observation
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: phase2-readonly-token-permission
+          path: PermissionObservation.json
+          if-no-files-found: error
