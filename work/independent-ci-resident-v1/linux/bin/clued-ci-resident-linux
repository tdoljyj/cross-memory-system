#!/usr/bin/python3.12 -I
"""Resident independent CI, Linux side (DRAFT). Installed root:root 0755 as
/opt/clued-independent-ci/resident-v1/bin/clued-ci-resident-linux and pinned, with every file it
guards, in /opt/clued-independent-ci/resident-v1/manifest.json (installedPath + sha256).

Sub-commands (all print one JSON object; exit 0 only on success):
  guard --unit worker|wsprep|archive --instance <id>   ExecStartPre of the three template units
  quiescence --batch <batchId>                         read-only proof, relayed verbatim by the companion
  archive --instance <batchId>_<reason>                rename-only archive (archive unit only)
  archive-status --instance <batchId>_<reason>         the receipt of exactly that archive run
  archive-usage                                        bytes kept by earlier archives (50 GB reminder)
  archive-prune                                        one retention pass of the spool archives (DESIGN S35)
  view-properties --instance <jobId>                   the worker unit's file-system view as systemd-run --property arguments
  view-check --instance <jobId>                        run inside that view: does it hide and expose what DESIGN 65.2 says

L2, every batch and role starts clean (DESIGN 65): the worker's guard refuses while any container carrying the bridge nonce
label exists, in any state (EARLIER_CONTAINER_PRESENT, with the ids); a failure-scope archive records each such exited/dead
container (inspect + diff) under resident/container-sweep/<instance>/ and removes it (docker rm --volumes) before it plans or
moves anything, so a refusal there leaves the instance runnable again; a completed scope that meets one refuses and changes
nothing (CONTAINER_PRESENT_PRESERVED). Containers are the only thing removed this way: never an image, volume or network.

Threat model: WSL root is reachable from the Owner's own user session (wsl -u root), so these facts
are as trustworthy as the Owner/root boundary accepted in constraint 4fedfc84, no more. What this tool
guarantees is that facts are measured, not assumed, and fail closed when they cannot be measured.

Quiescence (replaces the "kernel booted after the last write" proof that needed wsl --shutdown):
every clued-ci-*@ unit other than the caller is inactive/failed and its cgroup reports
"populated 0" in cgroup.events (cgroup v2 only; unreadable = not quiescent); every container carrying
the bridge nonce label is exited or dead (docker ps -a; created/running/paused/restarting = not
quiescent); no process command line names the worker or a run directory.

Archive scopes: "between-roles-N" moves only the protocol records (the existing linux-archive.py
semantics); "retry-stage-N-K" (generation 11, DESIGN 54: the K-th run again, K 1 or 2, of an execution stage
2, 4 or 6 in the same batch (stage 2: generation 14, DESIGN 59); each its own archive instance) is a failure scope that moves the protocol records as found, formal-role.lock and all run
directories but KEEPS this batch's workspaces and its ws-prep directory, which the run again needs;
every other reason moves the protocol records, formal-role.lock, all run directories, this batch's
workspaces and its ws-prep directory. Moves use renameat2(RENAME_NOREPLACE); no file is deleted (a
success-close slims candidate trees, S35; a failure scope removes leftover containers after recording them, DESIGN 65.4).

Source v2 (DESIGN S14, lessons b22/b28), mirroring resident-v2/archive-windows-spool.ps1:
  - destinations are FLAT names directly inside the archive directory (incoming-<leaf>,
    outgoing-<leaf>, run-<name>, workspace-<jobId>, ws-prep-<batchId>, formal-role.lock): no nested
    runs/ or workspaces/ directory is ever created (the runs/ prefix broke b28);
  - completed scopes (between-roles-N, success-close) refuse, moving nothing, when the spool holds an
    unknown leaf, a half record pair, or a still-held formal-role.lock: the role did not end the way a
    completed stage ends, so the scene is preserved for the failure path;
  - failure scopes archive what they find and report what was left in place;
  - every parent is a real directory (root-owned and not group/other-writable on the host), every moved
    directory tree is inventoried before and verified after the move, and every source is gone after;
  - a failure part-way leaves a durable partial status (verified false), never a missing one;
  - archive-usage reports the bytes kept by earlier archives (the resident's 50 GB reminder).

Retention and slimming (DESIGN S35, Task 4aedda54):
  - success-close archives keep no candidate source tree: after every move is verified, each
    workspace-<jobId>/candidate and run-<name>/candidate is replaced by candidate.slim.json (the commit SHA
    and a manifest hash of the whole tree), since git restores it from the commit; a tree whose commit is
    unknown, that holds a special file, or that cannot be removed safely is kept and reported. Failure
    archives stay complete;
  - archive-prune applies the resident's retention rule (src/retention.mjs, the same cases): per class
    (success: archive-*, completed-*; failure: failed-*) the newest 20 GiB and never fewer than the newest
    10 directories are kept, the Owner's keep list (resident/owner/retention-keep.json, read through /mnt/c)
    protects what it names, and the rest is deleted oldest first, at most 16 per pass. Only directly below
    the spool, only names of the three kinds, only when quiescent; a link, an unreadable size, an unreadable
    keep list or a directory that changed after planning deletes nothing more. Every pass writes a durable
    receipt under resident/retention/.
"""
import ctypes
import hashlib
import json
import os
import re
import secrets
import shutil
import stat as _st
import subprocess
import sys
import time

STATE = '/var/lib/clued-independent-ci'
SPOOL = f'{STATE}/formal-spool'
RESIDENT_STATE = f'{STATE}/resident'
OPT = '/opt/clued-independent-ci/resident-v1'
DESCRIPTORS = '/mnt/c/ProgramData/CluedIndependentCI/resident/outbox'
BATCH_ID = re.compile(r'^[0-9a-f]{16}-[0-9a-f]{12}$')
JOB_ID = re.compile(r'^[0-9a-f]{64}$')
REASON = re.compile(r'^[a-z0-9][a-z0-9-]{0,39}$')
UNIT = re.compile(r'^(clued-ci-(?:worker|wsprep|archive)@[0-9a-z_-]{1,120}\.service)\s+\S+\s+(\S+)\s+(\S+)')
SYSTEMCTL = '/usr/bin/systemctl'
DOCKER = '/usr/bin/docker'
ENV = {'PATH': '/usr/bin:/bin', 'LANG': 'C', 'LC_ALL': 'C'}
SEQ = [f'{i:02d}' for i in range(1, 33)]
# Linux view of the bridge records (mirror of the Windows view in src/archive.mjs).
LINUX_PROTOCOL = {
    'incoming': [f'{n}{s}' for n in ['issue'] + [f'response-{q}' for q in SEQ] for s in ('.json', '.ready.json')],
    'outgoing': [f'{n}{s}' for n in ['result', 'blocked'] + [f'challenge-{q}' for q in SEQ] for s in ('.json', '.ready.json')] + ['active.lock'],
}
MAX_LEAF = 1 << 20
MAX_TREE = 1_000_000
KEEP_FILE = '/mnt/c/ProgramData/CluedIndependentCI/resident/owner/retention-keep.json'
KEEP_CONTRACT = 'clued.independent-ci.archive-retention-keep/1'
PRUNE_CONTRACT = 'clued.independent-ci.linux-archive-prune/1'
SLIM_CONTRACT = 'clued.independent-ci.resident-linux-archive-slim/1'
ARCHIVE_NAME = re.compile(r'^(archive|completed|failed)-[0-9A-Za-z-]{1,90}$')
GIB = 1024 ** 3
RETENTION_RULE = {'classBudgetBytes': 20 * GIB, 'minKeepPerClass': 10, 'maxDeletesPerPass': 16}


class Refused(Exception):
    def __init__(self, code, details=None):
        super().__init__(code)
        self.code = code
        self.details = details  # printed with the refusal (journal), e.g. the container ids that block (DESIGN 65.4)


def need(cond, code):
    if not cond:
        raise Refused(code)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def run(argv, timeout=30):
    r = subprocess.run(argv, env=ENV, capture_output=True, text=True, timeout=timeout, check=False)
    return r.returncode, r.stdout


# ---------- pure helpers (unit-tested on any OS) ----------

def parse_instance(unit, instance):
    if unit == 'worker':
        need(JOB_ID.fullmatch(instance), 'WORKER_INSTANCE_REFUSED')
        return {'jobId': instance}
    if unit == 'wsprep':
        need(BATCH_ID.fullmatch(instance), 'WSPREP_INSTANCE_REFUSED')
        return {'batchId': instance}
    if unit == 'archive':
        batch, sep, reason = instance.partition('_')
        need(sep == '_' and BATCH_ID.fullmatch(batch) and REASON.fullmatch(reason), 'ARCHIVE_INSTANCE_REFUSED')
        return {'batchId': batch, 'reason': reason}
    raise Refused('UNIT_REFUSED')


def other_units_quiet(list_units_output, self_unit):
    """Names of clued-ci units other than the caller that are not inactive/failed."""
    busy = []
    for line in list_units_output.splitlines():
        m = UNIT.match(line.strip())
        if m and m.group(1) != self_unit and m.group(2) not in ('inactive', 'failed'):
            busy.append(m.group(1))
    return busy


def cgroup_unpopulated(events_text):
    """cgroup v2 cgroup.events covers the whole subtree: populated 0 means no process anywhere below."""
    if events_text is None:
        return False  # unreadable = not proven
    values = dict(line.split(' ', 1) for line in events_text.strip().splitlines() if ' ' in line)
    return values.get('populated') == '0'


def containers_quiet(ps_lines):
    """docker ps -a --format '{{.ID}} {{.State}}' for the nonce label: all must be exited or dead."""
    states = [line.split()[1] for line in ps_lines if len(line.split()) >= 2]
    return all(s in ('exited', 'dead') for s in states), states


def _protected_dir(path):
    """A real directory (no link); on the host also root-owned and not group/other-writable."""
    need(os.path.lexists(path) and not os.path.islink(path) and os.path.isdir(path), 'ARCHIVE_PARENT_REDIRECTED')
    if sys.platform.startswith('linux') and os.geteuid() == 0:
        st = os.lstat(path)
        need(st.st_uid == 0 and not (st.st_mode & 0o022), 'ARCHIVE_PARENT_UNPROTECTED')


def tree_inventory(path):
    """Digest of (relative path, type, inode, size, mtime) of a whole tree, links not followed."""
    h, n = hashlib.sha256(), 0
    for base, dirs, files in os.walk(path, followlinks=False):
        dirs.sort()
        for name in sorted(dirs + files):
            full = os.path.join(base, name)
            st = os.lstat(full)
            kind = 'l' if os.path.islink(full) else 'd' if os.path.isdir(full) else 'f'
            h.update(f'{os.path.relpath(full, path)}\0{kind}\0{st.st_ino}\0{st.st_size}\0{st.st_mtime_ns}\n'.encode())
            n += 1
            need(n <= MAX_TREE, 'ARCHIVE_TREE_BOUND')
    return h.hexdigest()


def _leaf(root, rel, target, flat):
    full = os.path.join(root, rel)
    st = os.lstat(full)
    need(not os.path.islink(full), 'ARCHIVE_LINK_REFUSED')
    is_dir = os.path.isdir(full)
    if not is_dir:
        need(st.st_nlink == 1 and st.st_size <= MAX_LEAF, 'ARCHIVE_LEAF_SHAPE_REFUSED')
    need(re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,200}', flat) is not None, 'ARCHIVE_FLAT_NAME_REFUSED')
    return {'from': rel, 'to': f'{target}/{flat}', 'isDir': is_dir, 'ino': st.st_ino, 'mtimeNs': st.st_mtime_ns,
            'sha256': None if is_dir else sha256_file(full), 'tree': tree_inventory(full) if is_dir else None}


def half_pairs(names):
    """Record names whose .json / .ready.json partner is missing."""
    bases = {n[:-len('.ready.json')] if n.endswith('.ready.json') else n[:-len('.json')] for n in names if n.endswith('.json')}
    return sorted(b for b in bases if (f'{b}.json' in names) != (f'{b}.ready.json' in names))


def plan_archive(root, batch_id, reason, job_ids, nonce_hex):
    need(BATCH_ID.fullmatch(batch_id) and REASON.fullmatch(reason) and re.fullmatch(r'[0-9a-f]{12}', nonce_hex), 'ARCHIVE_PLAN_REFUSED')
    need(all(JOB_ID.fullmatch(j) for j in job_ids), 'ARCHIVE_JOB_IDS_REFUSED')
    # Only the two exact between-role reasons are protocol-only; any other reason (including any
    # failure-derived text) archives the whole batch scene (third review, MAJOR 1).
    protocol_only = re.fullmatch(r'between-roles-[46]', reason) is not None
    # Generation 11 (DESIGN 54; stage 2: generation 14, DESIGN 59): only these exact reasons keep the workspaces; anything else is the full batch scene.
    keep_workspaces = re.fullmatch(r'retry-stage-[246]-[12]', reason) is not None
    completed = archive_scope_completed(reason)
    prefix = 'archive' if completed else 'failed'
    target = f'formal-spool/{prefix}-{batch_id[:12]}-{reason}-{nonce_hex}'
    _protected_dir(root)
    _protected_dir(os.path.join(root, 'formal-spool'))
    moves, unknown, halves = [], [], []
    for sub, names in LINUX_PROTOCOL.items():
        d = os.path.join(root, 'formal-spool', sub)
        if not os.path.lexists(d):
            continue
        _protected_dir(d)
        present = sorted(os.listdir(d))
        unknown += [f'{sub}/{n}' for n in present if n not in names]
        halves += [f'{sub}/{b}' for b in half_pairs([n for n in present if n in names])]
        for name in names:
            if os.path.lexists(os.path.join(d, name)):
                moves.append(_leaf(root, f'formal-spool/{sub}/{name}', target, f'{sub}-{name}'))
    role_lock = os.path.lexists(os.path.join(root, 'formal-role.lock'))
    if completed:
        # A completed stage leaves no unknown leaf, no half pair and no held role slot (b22/b28).
        need(not unknown, 'UNKNOWN_SPOOL_LEAF_PRESERVED')
        need(not halves, 'HALF_PROTOCOL_PAIR_PRESERVED')
        need(not role_lock, 'ROLE_LOCK_HELD_PRESERVED')
    if not protocol_only:
        if role_lock:
            moves.append(_leaf(root, 'formal-role.lock', target, 'formal-role.lock'))
        runs = os.path.join(root, 'runs')
        if os.path.lexists(runs):
            _protected_dir(runs)
            for name in sorted(os.listdir(runs)):
                moves.append(_leaf(root, f'runs/{name}', target, f'run-{name}'))
        if not keep_workspaces:
            if os.path.lexists(os.path.join(root, 'workspaces')):
                _protected_dir(os.path.join(root, 'workspaces'))
            for j in sorted(job_ids):
                if os.path.lexists(os.path.join(root, 'workspaces', j)):
                    moves.append(_leaf(root, f'workspaces/{j}', target, f'workspace-{j}'))
            if os.path.lexists(os.path.join(root, f'ws-prep-{batch_id}')):
                moves.append(_leaf(root, f'ws-prep-{batch_id}', target, f'ws-prep-{batch_id}'))
    flats = [m['to'] for m in moves]
    need(len(set(flats)) == len(flats), 'ARCHIVE_FLAT_NAME_COLLISION')
    # S35: a success-close archive keeps the commit SHA and manifest hash of each candidate tree instead of the tree.
    slim = reason == 'success-close'
    return {'contract': 'clued.independent-ci.resident-linux-archive/3', 'batchId': batch_id, 'reason': reason,
            'scope': 'protocol' if protocol_only else ('stage-retry' if keep_workspaces else 'batch'), 'completed': completed, 'target': target, 'moves': moves,
            'remainderLeftInPlace': unknown, 'halfPairs': halves, 'slimCandidates': slim, 'deletesAnything': slim}


def earlier_result(done_path):
    """A repeated archive instance (for example a re-arm retried after a lost answer) returns the
    verified result of the run that already happened, instead of refusing (review M6d)."""
    if not os.path.lexists(done_path):
        return None
    need(not os.path.islink(done_path), 'ARCHIVE_STATUS_LINK_REFUSED')
    with open(done_path) as f:
        earlier = json.load(f)
    return {**{k: earlier[k] for k in ('verified', 'moved', 'deleted', 'directory', 'scope', 'partial', 'code') if k in earlier}, 'replayed': True}


def rename_noreplace(src, dst):
    if sys.platform.startswith('linux'):
        libc = ctypes.CDLL('libc.so.6', use_errno=True)
        AT_FDCWD, RENAME_NOREPLACE = -100, 1
        if libc.renameat2(AT_FDCWD, src.encode(), AT_FDCWD, dst.encode(), RENAME_NOREPLACE) != 0:
            raise Refused('ARCHIVE_RENAME_REFUSED')
    else:  # offline tests on other systems
        need(not os.path.lexists(dst), 'ARCHIVE_RENAME_REFUSED')
        os.rename(src, dst)


def _durable_new(path, value):
    with open(path, 'x') as f:
        json.dump(value, f, sort_keys=True)
        f.flush()
        os.fsync(f.fileno())


def candidate_manifest(path):
    """One hash over the whole tree (relative path, kind, mode, size, content hash or link text), links not followed."""
    h, files, total, links, n = hashlib.sha256(), 0, 0, 0, 0
    for base, dirs, names in os.walk(path, followlinks=False):
        dirs.sort()
        for name in sorted(dirs + names):
            full = os.path.join(base, name)
            st = os.lstat(full)
            rel = os.path.relpath(full, path).replace(os.sep, '/')
            if _st.S_ISLNK(st.st_mode):
                kind, extra, size = 'l', os.readlink(full), 0
                links += 1
            elif _st.S_ISDIR(st.st_mode):
                kind, extra, size = 'd', '', 0
            elif _st.S_ISREG(st.st_mode):
                kind, extra, size = 'f', sha256_file(full), st.st_size
                files += 1
                total += st.st_size
            else:
                raise Refused('SLIM_SPECIAL_FILE_REFUSED')
            h.update(f'{rel}\0{kind}\0{st.st_mode & 0o7777:o}\0{size}\0{extra}\n'.encode('utf-8', 'surrogateescape'))
            n += 1
            need(n <= MAX_TREE, 'SLIM_TREE_BOUND')
    return {'manifestSha256': h.hexdigest(), 'files': files, 'bytes': total, 'links': links}


def candidate_commit(cand):
    """The detached HEAD of a candidate checkout (prepare-workspaces.py checks S out detached), or None."""
    head = os.path.join(cand, '.git', 'HEAD')
    if os.path.islink(head) or not os.path.isfile(head):
        return None
    with open(head, 'rb') as f:
        text = f.read(128).decode('ascii', 'replace').strip()
    return text if re.fullmatch(r'[0-9a-f]{40}', text) else None


def slim_success_archive(target, flats, rmtree=shutil.rmtree):
    """S35: replace each candidate tree of a verified success archive by its commit SHA and manifest hash. A run's
    candidate without its own .git takes the commit of the same job's workspace (run-placement-<jobId>). Never raises:
    a tree that cannot be slimmed safely is kept and reported."""
    found = []
    for flat in sorted(flats):
        if not re.fullmatch(r'workspace-[0-9a-f]{64}|run-[A-Za-z0-9][A-Za-z0-9._-]{0,200}', flat):
            continue
        cand = os.path.join(target, flat, 'candidate')
        if os.path.lexists(cand):
            found.append((flat, cand))
    commits = {flat: (candidate_commit(cand) if not os.path.islink(cand) else None) for flat, cand in found}
    for flat, _ in found:
        m = re.fullmatch(r'run-.*-([0-9a-f]{64})', flat)
        if commits[flat] is None and m:
            commits[flat] = commits.get(f'workspace-{m.group(1)}')
    slimmed, kept = [], []
    for flat, cand in found:
        try:
            need(not os.path.islink(cand) and os.path.isdir(cand), 'SLIM_LINK_REFUSED')
            need(commits[flat] is not None, 'SLIM_COMMIT_UNKNOWN')
            facts = candidate_manifest(cand)
            # A tree with links is removed only where rmtree cannot be led outside it (fd-based, Linux).
            need(facts['links'] == 0 or rmtree is not shutil.rmtree or shutil.rmtree.avoids_symlink_attacks, 'SLIM_LINK_REFUSED')
            record = {'contract': SLIM_CONTRACT, 'path': f'{flat}/candidate', 'commitSha': commits[flat], 'restoreFrom': 'git',
                      'manifestSha256': facts['manifestSha256'], 'files': facts['files'], 'bytes': facts['bytes'], 'links': facts['links']}
            _durable_new(os.path.join(target, flat, 'candidate.slim.json'), record)
            rmtree(cand)
            slimmed.append({k: record[k] for k in ('path', 'commitSha', 'manifestSha256', 'files', 'bytes')})
        except Refused as e:
            kept.append({'path': f'{flat}/candidate', 'code': e.code})
        except OSError:
            kept.append({'path': f'{flat}/candidate', 'code': 'SLIM_UNCONFIRMED'})
    return slimmed, kept


def apply_archive(root, plan, rename=rename_noreplace):
    target = os.path.join(root, plan['target'])
    os.mkdir(target, 0o700)
    _durable_new(os.path.join(target, 'intent.json'), plan)
    moved = 0
    try:
        for m in plan['moves']:
            src, dst = os.path.join(root, m['from']), os.path.join(root, m['to'])
            need(os.path.dirname(dst) == target, 'ARCHIVE_FLAT_NAME_REFUSED')  # never a nested destination (b28)
            st = os.lstat(src)
            need(not os.path.islink(src) and st.st_ino == m['ino'] and st.st_mtime_ns == m['mtimeNs'], 'ARCHIVE_LEAF_CHANGED_BEFORE_MOVE')
            if m['isDir']:
                need(tree_inventory(src) == m['tree'], 'ARCHIVE_TREE_CHANGED_BEFORE_MOVE')
            rename(src, dst)
            moved += 1
            st2 = os.lstat(dst)
            need(st2.st_ino == m['ino'] and (m['sha256'] is None or sha256_file(dst) == m['sha256']), 'ARCHIVE_LEAF_CHANGED_AFTER_MOVE')
            if m['isDir']:
                need(tree_inventory(dst) == m['tree'], 'ARCHIVE_TREE_CHANGED_AFTER_MOVE')
        # Postconditions: every source is gone; a completed scope leaves no known record behind.
        need(all(not os.path.lexists(os.path.join(root, m['from'])) for m in plan['moves']), 'ARCHIVE_SOURCE_STILL_PRESENT')
        if plan['completed']:
            for sub, names in LINUX_PROTOCOL.items():
                d = os.path.join(root, 'formal-spool', sub)
                need(not os.path.isdir(d) or not any(n in names for n in os.listdir(d)), 'ARCHIVE_POSTCONDITION_UNCONFIRMED')
    except Refused as e:
        # Part-way: durable partial status, so the failure is visible and never mistaken for "not run".
        _durable_new(os.path.join(target, 'partial.json'), {'verified': False, 'moved': moved, 'code': e.code})
        raise Refused(e.code) from None
    slimmed, slim_kept = [], []
    if plan.get('slimCandidates'):  # only after every move was verified; the moved trees themselves are already proven
        slimmed, slim_kept = slim_success_archive(target, [os.path.basename(m['to']) for m in plan['moves'] if m['isDir']])
    swept = plan.get('containersSwept', [])  # removed before any move, each with its evidence file (DESIGN 65.4)
    result = {'verified': True, 'moved': moved, 'deleted': len(slimmed) + len(swept), 'directory': os.path.basename(plan['target']), 'scope': plan['scope'],
              'remainderLeftInPlace': plan['remainderLeftInPlace'], 'halfPairs': plan['halfPairs'], 'slimmed': slimmed, 'slimKept': slim_kept,
              'containersSwept': swept}
    _durable_new(os.path.join(target, 'receipt.json'), result)
    return result


def archive_usage(root):
    """Bytes kept by earlier archives in the Linux spool (archive-* and failed-*); links not followed."""
    spool = os.path.join(root, 'formal-spool')
    total, dirs, n = 0, 0, 0
    if os.path.isdir(spool) and not os.path.islink(spool):
        for name in sorted(os.listdir(spool)):
            full = os.path.join(spool, name)
            if not re.fullmatch(r'(archive|failed)-[0-9A-Za-z-]+', name) or os.path.islink(full) or not os.path.isdir(full):
                continue
            dirs += 1
            for base, ds, fs in os.walk(full, followlinks=False):
                for f in fs:
                    n += 1
                    need(n <= 10 * MAX_TREE, 'ARCHIVE_USAGE_BOUND')
                    total += os.lstat(os.path.join(base, f)).st_size
    return {'contract': 'clued.independent-ci.linux-archive-usage/1', 'bytes': total, 'directories': dirs}


# ---------- retention (S35; the same rule as src/retention.mjs, held to test/fixtures/retention-cases.json) ----------

def archive_class(name):
    m = ARCHIVE_NAME.fullmatch(name)
    return None if m is None else ('failure' if m.group(1) == 'failed' else 'success')


def parse_keep_list(raw):
    try:
        v = json.loads(raw.decode('utf-8'))
    except (UnicodeDecodeError, ValueError):
        raise Refused('RETENTION_KEEP_LIST_INVALID')
    need(isinstance(v, dict) and sorted(v) == ['contract', 'keep'] and v['contract'] == KEEP_CONTRACT and isinstance(v['keep'], list)
         and len(v['keep']) <= 2000, 'RETENTION_KEEP_LIST_INVALID')
    for k in v['keep']:
        need(isinstance(k, dict) and sorted(k) == ['name', 'ref', 'spool'] and isinstance(k['name'], str) and ARCHIVE_NAME.fullmatch(k['name'])
             and k['spool'] in ('windows', 'linux', 'any') and isinstance(k['ref'], str) and 1 <= len(k['ref']) <= 200, 'RETENTION_KEEP_LIST_INVALID')
    return v['keep']


def read_keep_list(path, spool):
    """{'ok': True, 'names': set} or {'ok': False, 'code': ...}. A missing file refuses (RETENTION_KEEP_LIST_MISSING): an unknown
    list is never an empty one; only the Owner's file, even with an empty keep list, allows deletion. Only FileNotFoundError
    means missing: any other error of the lstat (EACCES, EIO on drvfs) is unreadable, never absent."""
    try:
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            return {'ok': False, 'code': 'RETENTION_KEEP_LIST_MISSING'}
        if not _st.S_ISREG(st.st_mode) or st.st_size > 256 * 1024:
            return {'ok': False, 'code': 'RETENTION_KEEP_LIST_INVALID'}
        with open(path, 'rb') as f:
            keep = parse_keep_list(f.read(256 * 1024 + 1))
        return {'ok': True, 'names': {k['name'] for k in keep if k['spool'] in (spool, 'any')}}
    except Refused as e:
        return {'ok': False, 'code': e.code}
    except OSError:
        return {'ok': False, 'code': 'RETENTION_KEEP_LIST_UNREADABLE'}


class _Desc:
    """Descending order for a string inside an ascending sort key."""
    def __init__(self, s):
        self.s = s

    def __lt__(self, other):
        return self.s > other.s

    def __eq__(self, other):
        return self.s == other.s


def plan_retention(entries, keep=frozenset(), rule=RETENTION_RULE):
    """Pure. entries: [{name, mtimeMs, bytes (None = unreadable), complete, isDir, links}]."""
    classes = {'success': [], 'failure': []}
    prot = {'directories': 0, 'bytes': 0, 'complete': True, 'names': []}
    for e in entries:
        cls = archive_class(e['name'])
        if cls is None:
            continue
        if e['name'] in keep:
            prot['directories'] += 1
            prot['bytes'] += e['bytes'] or 0
            prot['complete'] = prot['complete'] and e['bytes'] is not None and e['complete'] is True
            prot['names'].append(e['name'])
            continue
        classes[cls].append(e)
    prot['names'].sort()
    out = {'classes': {}, 'protected': prot, 'deletes': [], 'deferred': 0}
    deletes = []
    for cls in ('success', 'failure'):
        lst = classes[cls]
        refused = ('RETENTION_LINK_REFUSED' if any(e['isDir'] is not True or e['links'] > 0 for e in lst)
                   else 'RETENTION_SIZE_UNREADABLE' if any(e['bytes'] is None or e['complete'] is not True for e in lst) else None)
        total = sum(e['bytes'] or 0 for e in lst)
        summary = {'directories': len(lst), 'bytes': total, 'deleteDirectories': 0, 'deleteBytes': 0, 'refused': refused}
        out['classes'][cls] = summary
        if refused:
            continue
        newest_first = sorted(lst, key=lambda e: (-e['mtimeMs'], _Desc(e['name'])))
        remaining = len(newest_first)
        for e in reversed(newest_first):
            if total <= rule['classBudgetBytes'] or remaining <= rule['minKeepPerClass']:
                break
            deletes.append({'name': e['name'], 'class': cls, 'bytes': e['bytes'], 'mtimeMs': e['mtimeMs']})
            total -= e['bytes']
            remaining -= 1
            summary['deleteDirectories'] += 1
            summary['deleteBytes'] += e['bytes']
    deletes.sort(key=lambda d: (d['mtimeMs'], d['name']))
    out['deferred'] = max(0, len(deletes) - rule['maxDeletesPerPass'])
    out['deletes'] = [{'name': d['name'], 'class': d['class'], 'bytes': d['bytes']} for d in deletes[:rule['maxDeletesPerPass']]]
    return out


def tree_facts(path):
    total, entries, links, complete = 0, 0, 0, True

    def onerror(_):
        nonlocal complete
        complete = False
    for base, dirs, names in os.walk(path, followlinks=False, onerror=onerror):
        for name in dirs + names:
            entries += 1
            if entries > 10 * MAX_TREE:
                return {'bytes': total, 'entries': entries, 'links': links, 'complete': False}
            try:
                st = os.lstat(os.path.join(base, name))
            except OSError:
                complete = False
                continue
            if _st.S_ISLNK(st.st_mode):
                links += 1
            elif _st.S_ISREG(st.st_mode):
                total += st.st_size
            elif not _st.S_ISDIR(st.st_mode):
                links += 1  # a device, pipe or socket in an archive is as suspect as a link
    return {'bytes': total, 'entries': entries, 'links': links, 'complete': complete}


def entry_facts(spool, name):
    p = os.path.join(spool, name)
    try:
        st = os.lstat(p)
    except OSError:
        return {'name': name, 'mtimeMs': 0, 'bytes': None, 'complete': False, 'isDir': True, 'links': 0, 'entries': 0}
    if not _st.S_ISDIR(st.st_mode):
        return {'name': name, 'mtimeMs': st.st_mtime_ns // 1_000_000, 'bytes': None, 'complete': False, 'isDir': False, 'links': 1, 'entries': 0}
    t = tree_facts(p)
    return {'name': name, 'mtimeMs': st.st_mtime_ns // 1_000_000, 'bytes': t['bytes'] if t['complete'] else None, 'complete': t['complete'],
            'isDir': True, 'links': t['links'], 'entries': t['entries']}


def remove_tree(path):
    """Depth first, never following a link: a link met on the way stops the deletion (fail closed)."""
    st = os.lstat(path)
    need(_st.S_ISDIR(st.st_mode), 'RETENTION_LINK_REFUSED')
    for name in sorted(os.listdir(path)):
        p = os.path.join(path, name)
        s = os.lstat(p)
        need(not _st.S_ISLNK(s.st_mode), 'RETENTION_LINK_REFUSED')
        if _st.S_ISDIR(s.st_mode):
            remove_tree(p)
        else:
            os.unlink(p)
    os.rmdir(path)


def _refused_pass(rule, code):
    return {'rule': dict(rule), 'refused': code, 'classes': None, 'protected': None, 'deferred': 0, 'deleted': [], 'deletedBytes': 0, 'stopped': None}


def prune_spool(spool, keep, rule=RETENTION_RULE, remove=remove_tree):
    """One retention pass: inventory, plan, apply (each directory re-checked right before it goes)."""
    if not keep.get('ok'):
        return _refused_pass(rule, keep.get('code', 'RETENTION_KEEP_LIST_UNREADABLE'))
    try:
        if os.path.islink(spool) or not os.path.isdir(spool) or os.path.realpath(spool) != os.path.abspath(spool):
            return _refused_pass(rule, 'RETENTION_SPOOL_REDIRECTED')
        entries = [entry_facts(spool, n) for n in sorted(os.listdir(spool)) if archive_class(n)]
    except OSError:
        return _refused_pass(rule, 'RETENTION_SPOOL_UNREADABLE')
    plan = plan_retention(entries, keep['names'], rule)
    by_name = {e['name']: e for e in entries}
    deleted, stopped = [], None
    for d in plan['deletes']:
        now, before = entry_facts(spool, d['name']), by_name[d['name']]
        if not now['isDir'] or now['links'] > 0:
            stopped = {'name': d['name'], 'code': 'RETENTION_LINK_REFUSED', 'partial': False}
            break
        if now['bytes'] != before['bytes'] or now['entries'] != before['entries']:
            stopped = {'name': d['name'], 'code': 'RETENTION_CHANGED_SINCE_PLAN', 'partial': False}
            break
        try:
            remove(os.path.join(spool, d['name']))
            deleted.append(d)
        except Refused as e:
            stopped = {'name': d['name'], 'code': e.code, 'partial': True}
            break
        except OSError as e:
            stopped = {'name': d['name'], 'code': 'RETENTION_PERMISSION_REFUSED' if isinstance(e, PermissionError) else 'RETENTION_DELETE_UNCONFIRMED', 'partial': True}
            break
    return {'rule': dict(rule), 'refused': None, 'classes': plan['classes'], 'protected': plan['protected'], 'deferred': plan['deferred'],
            'deleted': deleted, 'deletedBytes': sum(d['bytes'] for d in deleted), 'stopped': stopped}


def public_prune(facts):
    """The answer's shape (mailbox.mjs#validatePrune): the protected names stay in the local receipt."""
    prot = facts['protected']
    return {**facts, 'protected': None if prot is None else {k: prot[k] for k in ('directories', 'bytes', 'complete')}}


def verify_pins(manifest):
    """Every pinned file at its installed path: this tool, the unit files, and the external entry
    points the units run (node, linux-worker.mjs, prepare-workspaces.py) from the installed Source."""
    for f in manifest['files']:
        need(os.path.isabs(f['installedPath']) and '..' not in f['installedPath'].split('/'), 'RESIDENT_LINUX_MANIFEST_REFUSED')
        need(sha256_file(f['installedPath']) == f['sha256'], 'RESIDENT_LINUX_PIN_CHANGED')


# ---------- L2: a clean start for every batch and role (DESIGN 65) ----------

NONCE_LABEL = 'clued.verify.nonce'
# Every container any role creates carries this label (verify-worker.mjs#createArguments, formal-trivy-v3/docker.mjs); full ids.
NONCE_LIST = ['ps', '--all', '--no-trunc', '--filter', f'label={NONCE_LABEL}', '--format', '{{.ID}} {{.State}}']
# The only docker sub-commands this tool runs. Never rmi, image, prune, volume, network, system: the image store is a cache.
DOCKER_VERBS = ('ps', 'inspect', 'diff', 'rm')
CONTAINER_ID = re.compile(r'^[0-9a-f]{64}$')
SWEEP_CONTRACT = 'clued.independent-ci.resident-linux-container-sweep/1'
VIEW_CONTRACT = 'clued.independent-ci.worker-view-check/1'
MAX_DOCKER_OUT = 1 << 20
TRIVY_CACHE = '/var/lib/clued-independent-ci-trivy-cache'
WORKER_UNIT_FILE = '/etc/systemd/system/clued-ci-worker@.service'
# The [Service] settings that build the worker's file-system view; view-properties hands exactly these to systemd-run.
VIEW_KEYS = ('ProtectSystem', 'ProtectHome', 'PrivateTmp', 'PrivateIPC', 'ReadWritePaths', 'ReadOnlyPaths', 'InaccessiblePaths',
             'TemporaryFileSystem', 'BindPaths')
LEGACY_STATE = ('verify-spool', 'verify-once-state', 'trusted-source')


def archive_scope_completed(reason):
    """between-roles-4/6 and success-close are the completed scopes (b22/b28): they preserve an unexpected scene."""
    return re.fullmatch(r'between-roles-[46]', reason) is not None or reason == 'success-close'


def parse_nonce_list(text):
    rows = []
    for line in text.splitlines():
        if not line.strip():
            continue
        parts = line.split()
        need(len(parts) == 2 and CONTAINER_ID.fullmatch(parts[0]) is not None, 'DOCKER_READ_UNCONFIRMED')
        rows.append((parts[0], parts[1]))
    return rows


def list_nonce(docker):
    code, out = docker(NONCE_LIST)
    need(code == 0, 'DOCKER_READ_UNCONFIRMED')
    return parse_nonce_list(out)


def guard_no_earlier_containers(docker, sleep=time.sleep, tries=3, pause_s=2.0):
    """A worker starts only when no labelled container exists in ANY state: nothing an earlier batch or role ran is still there.
    An unreadable list is asked again (three reads, 2 s apart) before refusing."""
    for attempt in range(tries):
        try:
            rows = list_nonce(docker)
            break
        except Refused:
            if attempt == tries - 1:
                raise
            sleep(pause_s)
    if rows:
        raise Refused('EARLIER_CONTAINER_PRESENT', [f'{cid} {state}' for cid, state in rows])
    return {'containersPresent': 0}


def sweep_containers(docker, evidence_dir, completed, now=lambda: time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())):
    """Archive step (DESIGN 65.4), after quiescence and BEFORE anything is moved or any status is written, so a refusal leaves the
    instance runnable again. A completed scope with a labelled container refuses and changes nothing; a failure scope records each
    exited/dead container (docker inspect + docker diff) in a create-only evidence file, removes it (docker rm --volumes, no
    --force), and proves the list empty afterwards."""
    rows = list_nonce(docker)
    if not rows:
        return []
    ids = [f'{cid} {state}' for cid, state in rows]
    if completed:
        raise Refused('CONTAINER_PRESENT_PRESERVED', ids)
    if any(state not in ('exited', 'dead') for _, state in rows):
        raise Refused('CONTAINER_NOT_QUIET', ids)
    parent = os.path.dirname(evidence_dir)
    _protected_dir(os.path.dirname(parent))  # resident/: checked before anything is created below it
    for d in (parent, evidence_dir):
        os.makedirs(d, mode=0o700, exist_ok=True)
        _protected_dir(d)
    swept = []
    for cid, state in rows:
        code, out = docker(['inspect', '--type', 'container', cid])
        if code != 0:
            raise Refused('CONTAINER_SWEEP_UNCONFIRMED', ids)
        try:
            inspect = json.loads(out)
        except ValueError:
            raise Refused('CONTAINER_SWEEP_UNCONFIRMED', ids)
        one = isinstance(inspect, list) and len(inspect) == 1 and isinstance(inspect[0], dict)
        labels = ((inspect[0].get('Config') or {}).get('Labels') or {}) if one else {}
        if not (one and inspect[0].get('Id') == cid and NONCE_LABEL in labels):
            raise Refused('CONTAINER_IDENTITY_UNCONFIRMED', ids)
        dcode, diff = docker(['diff', cid])  # measured, not assumed: what the container's writable layer holds
        record = {'contract': SWEEP_CONTRACT, 'id': cid, 'state': state, 'observedAt': now(), 'inspect': inspect[0],
                  'diff': diff.splitlines() if dcode == 0 else None, 'diffExitCode': dcode}
        name = f'container-{cid}-{secrets.token_hex(6)}.json'
        _durable_new(os.path.join(evidence_dir, name), record)
        code, _ = docker(['rm', '--volumes', cid])
        if code != 0:
            raise Refused('CONTAINER_SWEEP_UNCONFIRMED', ids)
        swept.append({'id': cid, 'state': state, 'evidence': name, 'evidenceSha256': sha256_file(os.path.join(evidence_dir, name)),
                      'diffEntries': None if record['diff'] is None else len(record['diff'])})
    left = list_nonce(docker)
    if left:
        raise Refused('CONTAINER_SWEEP_UNCONFIRMED', [f'{cid} {state}' for cid, state in left])
    return swept


def namespace_properties(unit_text, job_id):
    """systemd-run --property arguments carrying exactly the worker unit's file-system view for one job id (rehearsal probe,
    DESIGN 65.7). Only the %i specifier is allowed in these settings."""
    need(JOB_ID.fullmatch(job_id) is not None, 'WORKER_INSTANCE_REFUSED')
    props = []
    for line in unit_text.splitlines():
        key, sep, value = line.partition('=')
        if sep and key in VIEW_KEYS:
            need('%' not in value.replace('%i', ''), 'VIEW_SPECIFIER_REFUSED')
            props.append(f'--property={key}={value.replace("%i", job_id)}')
    need(any(p.startswith('--property=TemporaryFileSystem=') for p in props), 'VIEW_SETTINGS_MISSING')
    return props


def view_facts(job_id, entries, writable):
    """What a worker run must see (DESIGN 65.2), read from inside its namespace. entries(path) -> sorted names or None (absent or not
    readable); writable(path) -> bool. Pure; the CLI view-check feeds it os.listdir / os.access."""
    need(JOB_ID.fullmatch(job_id) is not None, 'WORKER_INSTANCE_REFUSED')
    hidden = lambda p: entries(p) in (None, [])
    fails = []

    def want(cond, code):
        if not cond:
            fails.append(code)
    spool, ws = entries(SPOOL), entries(f'{STATE}/workspaces')
    want(spool is not None and set(spool) <= {'incoming', 'outgoing'}, 'EARLIER_ARCHIVES_VISIBLE')
    want(ws is not None and set(ws) <= {job_id}, 'OTHER_WORKSPACES_VISIBLE')
    want(hidden(RESIDENT_STATE), 'RESIDENT_STATE_VISIBLE')
    want(all(hidden(f'{STATE}/{n}') for n in LEGACY_STATE), 'LEGACY_STATE_VISIBLE')
    want(hidden('/mnt') and hidden('/run/WSL'), 'WINDOWS_PATHS_VISIBLE')
    want(not writable(f'{STATE}/toolchain-build-legacy-v1'), 'TOOLCHAIN_WRITABLE')
    want(not writable(SPOOL) and not writable(f'{STATE}/workspaces'), 'VIEW_ROOT_WRITABLE')
    want(not writable('/etc/clued-independent-ci') and not writable(OPT), 'TRUSTED_TREE_WRITABLE')
    want(writable(STATE), 'STATE_ROOT_NOT_WRITABLE')  # formal-role.lock (Source SERIAL_LOCK) is created here
    for p in (f'{SPOOL}/incoming', f'{SPOOL}/outgoing', f'{STATE}/runs', f'{STATE}/workspaces/{job_id}', TRIVY_CACHE):
        if entries(p) is not None:
            want(writable(p), 'NOT_WRITABLE:' + p)
    return {'contract': VIEW_CONTRACT, 'jobId': job_id, 'ok': not fails, 'failures': fails}


def _entries(path):
    try:
        return sorted(os.listdir(path))
    except OSError:
        return None


def docker_port(argv, timeout=60):
    """One docker call with a fixed verb, a time limit and a 1 MiB output bound; (exit code, stdout)."""
    need(isinstance(argv, list) and argv and argv[0] in DOCKER_VERBS, 'DOCKER_VERB_REFUSED')
    try:
        r = subprocess.run([DOCKER] + argv, env=ENV, capture_output=True, timeout=timeout, check=False)
    except subprocess.TimeoutExpired:
        return 124, ''
    need(len(r.stdout) <= MAX_DOCKER_OUT, 'DOCKER_OUTPUT_BOUND')
    return r.returncode, r.stdout.decode('utf-8', 'replace')


# ---------- host commands (Linux, root) ----------

def unit_name(kind, instance):
    return f'clued-ci-{kind}@{instance}.service'


def list_units():
    code, out = run([SYSTEMCTL, 'list-units', '--all', '--plain', '--no-legend', 'clued-ci-*@*.service'])
    need(code == 0, 'SYSTEMCTL_LIST_UNCONFIRMED')
    return out


def cgroup_events(unit):
    code, out = run([SYSTEMCTL, 'show', '--property=ControlGroup', '--value', unit])
    if code != 0:
        return None
    cg = out.strip()
    if not cg:
        return 'populated 0\n'  # systemd reports no control group for a unit with no processes
    try:
        with open(f'/sys/fs/cgroup{cg}/cgroup.events') as f:
            return f.read()
    except OSError:
        return 'populated 0\n' if not os.path.exists(f'/sys/fs/cgroup{cg}') else None


def nonce_containers():
    code, out = run([DOCKER] + NONCE_LIST, timeout=60)
    need(code == 0, 'DOCKER_READ_UNCONFIRMED')
    return [l for l in out.splitlines() if l.strip()]


def worker_processes():
    hits = []
    for pid in filter(str.isdigit, os.listdir('/proc')):
        try:
            cmd = open(f'/proc/{pid}/cmdline', 'rb').read().replace(b'\0', b' ')
        except OSError:
            continue
        if b'linux-worker.mjs' in cmd or b'/var/lib/clued-independent-ci/runs/' in cmd:
            hits.append(int(pid))
    return hits


def quiescence(self_unit=None):
    need(os.path.exists('/sys/fs/cgroup/cgroup.controllers'), 'CGROUP_V2_REQUIRED')
    out = list_units()
    busy = other_units_quiet(out, self_unit)
    names = [m.group(1) for m in (UNIT.match(l.strip()) for l in out.splitlines()) if m and m.group(1) != self_unit]
    unpopulated = all(cgroup_unpopulated(cgroup_events(n)) for n in names)
    quiet, states = containers_quiet(nonce_containers())
    procs = worker_processes()
    return {'linuxUnitsInactive': not busy and unpopulated and not procs, 'containersZero': quiet,
            'details': {'busyUnits': busy, 'cgroupsUnpopulated': unpopulated, 'containerStates': states, 'workerProcesses': procs}}


# Job contract /3 (quota phase 2 step 3b) names the tested commit S; descriptor /3 carries it. Only /3 exists after a
# reinstall: the uninstall renames the whole resident directory, outbox included, so no /2 descriptor is left to archive.
JOB_CONTRACT = 'clued.independent-ci.job/3'
DESCRIPTOR_CONTRACT = 'clued.independent-ci.resident-batch-descriptor/3'
LINUX_ROLES = ('gitleaks', 'trivy', 'contract-placement')
HEX40 = re.compile(r'^[0-9a-f]{40}$')
HEX64 = re.compile(r'^[0-9a-f]{64}$')


def job_id_v2(d, role):
    """Same formula as job-v2.mjs#jobIdV2 and prepare-workspaces.py#job_id_v2 (a test keeps them equal): contract /3,
    with the tested commit. The function keeps its v2 (Source v2) name."""
    ident = [JOB_CONTRACT, d['repo'], d['pr'], d['headSha'], d['baseSha'], d['testSha'], d['ciSourceManifestSha256'], role, d['attempt']]
    return hashlib.sha256(json.dumps(ident, separators=(',', ':'), ensure_ascii=False).encode('utf-8')).hexdigest()


def descriptor_job_ids(raw, batch_id):
    """Review MINOR-8: the job ids whose workspaces an archive may move are re-derived from the descriptor's
    CONTENT (as prepare-workspaces.py does), never taken from its linuxJobIds list; a list that disagrees with
    the content refuses the archive. Pure."""
    need(isinstance(raw, bytes) and 0 < len(raw) <= 65536, 'DESCRIPTOR_REFUSED')
    try:
        d = json.loads(raw.decode('utf-8'))
    except (UnicodeDecodeError, ValueError):
        raise Refused('DESCRIPTOR_REFUSED')
    need(isinstance(d, dict) and d.get('contract') == DESCRIPTOR_CONTRACT and d.get('batchId') == batch_id, 'DESCRIPTOR_REFUSED')
    need(d.get('repo') == 'tdoljyj/cross-memory-system' and isinstance(d.get('pr'), int) and not isinstance(d.get('pr'), bool) and d['pr'] > 0, 'DESCRIPTOR_REFUSED')
    need(all(isinstance(d.get(k), str) and HEX40.fullmatch(d[k]) for k in ('headSha', 'baseSha', 'testSha')), 'DESCRIPTOR_REFUSED')
    need(isinstance(d.get('ciSourceManifestSha256'), str) and HEX64.fullmatch(d['ciSourceManifestSha256']) and d.get('attempt') in (1, 2) and not isinstance(d.get('attempt'), bool), 'DESCRIPTOR_REFUSED')
    need(isinstance(d.get('batchKey'), str) and HEX64.fullmatch(d['batchKey']) and d['batchKey'][:16] == batch_id[:16], 'DESCRIPTOR_REFUSED')
    derived = [job_id_v2(d, role) for role in LINUX_ROLES]
    need(d.get('linuxJobIds') == derived, 'EXACT_CONTENT_JOB_ID_REQUIRED')
    return derived


def read_descriptor_bytes(batch_id):
    """One no-follow handle: the descriptor itself may not be a link, and its size bound is taken from the
    handle that is read (no lstat-then-open gap)."""
    path = f'{DESCRIPTORS}/{batch_id}/descriptor.json'
    fd = os.open(path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_CLOEXEC', 0))
    try:
        st = os.fstat(fd)
        need(stat_regular(st) and 0 < st.st_size <= 65536, 'DESCRIPTOR_REFUSED')
        raw = os.read(fd, 65537)
        need(len(raw) == st.st_size, 'DESCRIPTOR_REFUSED')
        return raw
    finally:
        os.close(fd)


def stat_regular(st):
    import stat as _stat
    return _stat.S_ISREG(st.st_mode)


def main(argv):
    need(os.geteuid() == 0, 'ROOT_REQUIRED')
    cmd = argv[0] if argv else ''
    args = dict(zip(argv[1::2], argv[2::2]))
    if cmd == 'guard':
        unit, inst = args.get('--unit'), args.get('--instance', '')
        parsed = parse_instance(unit, inst)
        verify_pins(json.load(open(f'{OPT}/manifest.json')))
        need(not other_units_quiet(list_units(), unit_name(unit, inst)), 'ANOTHER_CLUED_CI_UNIT_ACTIVE')
        if unit == 'worker':
            issue = json.load(open(f'{SPOOL}/incoming/issue.json'))
            need(issue.get('job', {}).get('id') == parsed['jobId'], 'WORKER_INSTANCE_NOT_THE_ISSUED_JOB')
            # DESIGN 65.3: only the worker checks (a refusal there is an abandoned stage whose retry archive sweeps); ws-prep does
            # not, since its refusal burns the head (review M1).
            guard_no_earlier_containers(docker_port)
        return {'status': 'GUARD_PASSED', 'unit': unit}
    if cmd == 'view-properties':
        inst = args.get('--instance', '')
        with open(WORKER_UNIT_FILE) as f:
            return {'contract': VIEW_CONTRACT, 'properties': namespace_properties(f.read(), inst)}
    if cmd == 'view-check':  # exit 0 only when the view is exactly as DESIGN 65.3 says
        facts = view_facts(args.get('--instance', ''), _entries, lambda p: os.access(p, os.W_OK))
        if not facts['ok']:
            raise Refused('WORKER_VIEW_CHECK_FAILED', facts['failures'])
        return facts
    if cmd == 'quiescence':
        need(BATCH_ID.fullmatch(args.get('--batch', '')), 'BATCH_REFUSED')
        return quiescence()
    if cmd == 'archive':
        inst = args.get('--instance', '')
        parsed = parse_instance('archive', inst)
        status_dir = f'{RESIDENT_STATE}/archive-status'
        os.makedirs(status_dir, mode=0o700, exist_ok=True)
        earlier = earlier_result(f'{status_dir}/{inst}.json')
        if earlier is not None:  # the same archive already ran: report it again, move nothing
            return earlier
        q = quiescence(self_unit=unit_name('archive', inst))
        need(q['linuxUnitsInactive'] and q['containersZero'], 'ARCHIVE_REQUIRES_QUIESCENCE')
        # DESIGN 65.4: before planning and before any status is written, so a refusal here leaves the instance runnable (review B1).
        swept = sweep_containers(docker_port, f'{RESIDENT_STATE}/container-sweep/{inst}', archive_scope_completed(parsed['reason']))
        # A re-arm of a quarantined entry may not know the batch's descriptor; then workspaces are
        # left in place (only an identical job id could collide with them, and that head is burned).
        if parsed['reason'].startswith('rearm-') and not os.path.lexists(f"{DESCRIPTORS}/{parsed['batchId']}/descriptor.json"):
            job_ids = []
        else:
            job_ids = descriptor_job_ids(read_descriptor_bytes(parsed['batchId']), parsed['batchId'])
        plan = plan_archive(STATE, parsed['batchId'], parsed['reason'], job_ids, secrets.token_hex(6))
        plan['containersSwept'] = swept
        plan['deletesAnything'] = plan['deletesAnything'] or bool(swept)
        try:
            result = apply_archive(STATE, plan)
        except Refused as e:  # one status per instance, create-only, durable: partial is never "missing"
            _durable_new(f'{status_dir}/{inst}.json', {'verified': False, 'partial': True, 'code': e.code, 'directory': os.path.basename(plan['target']), 'quiescence': q})
            raise
        _durable_new(f'{status_dir}/{inst}.json', {**result, 'quiescence': q})
        return result
    if cmd == 'archive-status':
        inst = args.get('--instance', '')
        parse_instance('archive', inst)
        return json.load(open(f'{RESIDENT_STATE}/archive-status/{inst}.json'))
    if cmd == 'archive-usage':
        return archive_usage(STATE)
    if cmd == 'archive-prune':
        q = quiescence()
        if q['linuxUnitsInactive'] and q['containersZero']:
            facts = prune_spool(SPOOL, read_keep_list(KEEP_FILE, 'linux'))
        else:
            facts = _refused_pass(RETENTION_RULE, 'ARCHIVE_PRUNE_REQUIRES_QUIESCENCE')
        receipts = f'{RESIDENT_STATE}/retention'
        os.makedirs(receipts, mode=0o700, exist_ok=True)
        _durable_new(f'{receipts}/{int(time.time() * 1000):013d}-{secrets.token_hex(6)}.json', {'contract': PRUNE_CONTRACT, **facts})
        return {'contract': PRUNE_CONTRACT, 'prune': public_prune(facts), 'usage': archive_usage(STATE)}
    raise Refused('COMMAND_REFUSED')


if __name__ == '__main__':
    try:
        print(json.dumps(main(sys.argv[1:]), sort_keys=True))
        sys.exit(0)
    except Refused as e:
        print(json.dumps({'status': 'REFUSED', 'code': e.code, **({'details': e.details} if e.details is not None else {})}, sort_keys=True))
        sys.exit(1)
    except (OSError, ValueError, KeyError) as e:
        print(json.dumps({'status': 'REFUSED', 'code': 'LINUX_TOOL_UNCONFIRMED', 'kind': type(e).__name__}))
        sys.exit(1)
