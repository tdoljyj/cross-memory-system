# (item, key in PRODUCTION or None for a unit, kind); the order of every switch and rollback.
ITEMS = (('source-v2', 'source', 'dir'), ('formal-source-manifest-v2.json', 'manifest', 'file'), ('roles-v3', 'roles', 'dir'),
         ('resident-v1', 'resident', 'dir')) + tuple((f'units/{u}', None, 'file') for u in UNITS)
SOURCE_ITEMS = ('source-v2', 'formal-source-manifest-v2.json', 'roles-v3')
RESIDENT_FILES = {'linux/bin/clued-ci-resident-linux': ('resident-v1/bin/clued-ci-resident-linux', 0o755),
                  'linux/manifest.json': ('resident-v1/manifest.json', 0o644),
                  **{f'linux/systemd/{u}': (f'units/{u}', 0o644) for u in UNITS}}
UPGRADE_FILES = {'linux/upgrade-v1/bin/' + TOOL_NAME: 'bin/' + TOOL_NAME, 'linux/upgrade-v1/bin/' + SIGNER_NAME: 'bin/' + SIGNER_NAME,
                 'linux/upgrade-v1/manifest.json': 'manifest.json'}
IGNORED_FILES = ('linux/bin/clued-ci-install-source-v2',)  # run once by root from the package, never installed
HEX40 = re.compile(r'^[0-9a-f]{40}$')
