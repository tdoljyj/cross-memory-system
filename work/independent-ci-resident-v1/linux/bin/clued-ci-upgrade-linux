CI = 'work/actions-hosted-migration/independent-ci-v1/'
# qualification-v2.mjs:46-56: the qualification fields that bind the Source (everything else is a host fact).
SOURCE_KEYS = ('sourceManifestSha256', 'entrySha256', 'qualificationSha256', 'workerSha256', 'proofSha256', 'jobSha256', 'sourceAcceptanceRef')
PIN_FILES = {'qualificationSha256': CI + 'worker/qualification-v2.mjs', 'workerSha256': CI + 'src/worker-v2.mjs',
             'proofSha256': CI + 'src/proof.mjs', 'jobSha256': CI + 'src/job-v2.mjs'}
BIND = ('runtimeIdentity', 'sourceManifestSha256', 'image', 'entrySha256', 'qualificationSha256', 'executionMode', 'workerSha256', 'proofSha256',
        'jobSha256', 'nodeExecutable', 'keyId', 'hostAcceptanceRef', 'sourceAcceptanceRef')
