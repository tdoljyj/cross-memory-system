    'opt': '/opt/clued-independent-ci',
    'source': '/opt/clued-independent-ci/source-v2',
    'resident': '/opt/clued-independent-ci/resident-v1',
    'upgrade': '/opt/clued-independent-ci/upgrade-v1',
