#!/usr/bin/python3.12 -I
"""One pass of the WSL memory guard (Task 7c2e4386), run every 60 s by clued-wsl-memguard.timer as root.

Every Windows->WSL hv_sock channel needs one free block of the ring order (order 7 with the 212992-byte socket
defaults, order 5 with the host-tuning drop-in). An allocation fails only when no zone can supply such a block
(2026-10-22 13:22Z: DMA32 and Normal both empty), so the guard counts the free blocks of at least that order
summed over the zones. Below LOW_BLOCKS it compacts memory, unless a compaction in the last COMPACT_BACKOFF
seconds both gained fewer than MIN_GAIN blocks and left the count below LOW_BLOCKS (then compacting again would
only churn the running scans; one that got the count back over the threshold stays worth repeating); if the
count is still low it drops clean page cache (echo 1: never slab, dirty or mapped pages) and compacts again, at
most once every DROP_INTERVAL seconds. Times are CLOCK_BOOTTIME, and /run is per boot, so they never jump.

It only writes /proc/sys/vm/compact_memory and drop_caches and its own files under /run/clued-wsl-memguard; it
starts, stops or reads nothing of the resident CI. It prints one JSON line when it acted, and one status line
every REPORT_INTERVAL seconds so the observation period shows how close the count runs to the threshold.
"""
import json
import os
import sys
import time

PROC_SYS = '/proc/sys'
BUDDYINFO = '/proc/buddyinfo'
STATE = '/run/clued-wsl-memguard'
LOW_BLOCKS = 64
MIN_GAIN = 8
COMPACT_BACKOFF = 300
DROP_INTERVAL = 300
REPORT_INTERVAL = 600
PAGE = 4096
HVS_MIN, HVS_MAX = 6 * PAGE, 64 * PAGE


def ring_order(rmem, wmem):
    """Same arithmetic as clued-wsl-host-tuning: each direction clamped to 6..64 pages, one allocation."""
    def one(buf):
        return -(-min(max(buf, HVS_MIN), HVS_MAX) // PAGE)
    return (one(rmem) + one(wmem) - 1).bit_length()


def zone_blocks(buddyinfo, order):
    """{zone: free blocks of at least order}."""
    out = {}
    for line in buddyinfo.splitlines():
        parts = line.split()
        if len(parts) >= 15 and parts[0] == 'Node' and parts[2] == 'zone':
            out[parts[3]] = out.get(parts[3], 0) + sum(int(x) for x in parts[4 + order:15])
    return out


def blocks_at_least(buddyinfo, order):
    return sum(zone_blocks(buddyinfo, order).values())


def due(now, last, interval):
    return last is None or now - last >= interval


def boottime():
    return time.clock_gettime(getattr(time, 'CLOCK_BOOTTIME', time.CLOCK_MONOTONIC))


def read(path):
    with open(path) as f:
        return f.read()


def write(path, value):
    with open(path, 'w') as f:
        f.write(value)


def load(state, name, fields):
    """The numbers stored in a state file, or None when it is missing or not exactly that many numbers (a damaged
    file then counts as no record instead of failing every later pass)."""
    try:
        values = [float(x) for x in read(f'{state}/{name}').split()]
    except (OSError, ValueError):
        return None
    return values if len(values) == fields else None


def guard_pass(proc_sys=PROC_SYS, buddyinfo=BUDDYINFO, state=STATE, clock=boottime, low=LOW_BLOCKS):
    # Fail loudly (unit Result=exit-code) when anything this pass may write cannot be written, even on a quiet
    # pass, and before any action: a drop is never done without its time stamp.
    for name in ('compact_memory', 'drop_caches'):
        os.close(os.open(f'{proc_sys}/vm/{name}', os.O_WRONLY))
    write(f'{state}/probe', '')
    now = clock()
    order = ring_order(int(read(f'{proc_sys}/net/core/rmem_default')), int(read(f'{proc_sys}/net/core/wmem_default')))
    zones = zone_blocks(read(buddyinfo), order)
    before = sum(zones.values())
    report = load(state, 'last-report', 1)
    if before >= low:
        if not due(now, report and report[0], REPORT_INTERVAL):
            return None
        write(f'{state}/last-report', f'{now}\n')
        return {'guard': 'clued-wsl-memguard', 'status': 'OK', 'order': order, 'low': low, 'blocks': before, 'zones': zones}
    result = {'guard': 'clued-wsl-memguard', 'status': 'BACKOFF', 'order': order, 'low': low, 'before': before, 'zones': zones,
              'compacted': False, 'dropped': False}
    after = before
    last_compact = load(state, 'last-compact', 3)  # [time, gain, count after]
    if (last_compact is None or due(now, last_compact[0], COMPACT_BACKOFF)
            or last_compact[1] >= MIN_GAIN or last_compact[2] >= low):
        write(f'{state}/last-compact', f'{now} 0 0\n')
        write(f'{proc_sys}/vm/compact_memory', '1\n')
        after = blocks_at_least(read(buddyinfo), order)
        write(f'{state}/last-compact', f'{now} {after - before} {after}\n')
        result.update(status='ACTED', compacted=True, afterCompact=after)
    last_drop = load(state, 'last-drop', 1)
    if after < low and due(now, last_drop and last_drop[0], DROP_INTERVAL):
        write(f'{state}/last-drop', f'{now}\n')
        write(f'{proc_sys}/vm/drop_caches', '1\n')
        write(f'{proc_sys}/vm/compact_memory', '1\n')
        after_drop = blocks_at_least(read(buddyinfo), order)
        write(f'{state}/last-compact', f'{now} {after_drop - after} {after_drop}\n')
        result.update(status='ACTED', dropped=True, afterDrop=after_drop)
    write(f'{state}/last-report', f'{now}\n')
    return result


if __name__ == '__main__':
    try:
        r = guard_pass()
    except (OSError, ValueError) as e:
        print(json.dumps({'guard': 'clued-wsl-memguard', 'status': 'FAILED', 'kind': type(e).__name__}))
        sys.exit(1)
    if r is not None:
        print(json.dumps(r, sort_keys=True))
