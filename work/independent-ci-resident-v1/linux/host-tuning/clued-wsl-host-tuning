#!/usr/bin/python3.12 -I
"""WSL host tuning for the resident executor's Linux side (Task 7c2e4386). Not part of the pinned resident
layer: it changes four kernel settings of the WSL VM, nothing the per-batch drift check covers.

Why: every hv_sock connection Windows opens into the VM (each wsl.exe launch opens six, and the companion
lists the Linux spool with one wsl.exe per second during every Linux stage) makes the guest open a VMBus
channel whose two ring buffers are sized from the listening socket's buffers, i.e. net.core.wmem_default and
net.core.rmem_default (212992 bytes each), and allocated together as one physically contiguous block:
2 x 52 pages = 104 pages = order 7 (512 KiB), GFP_KERNEL, a costly order the allocator does not retry. With
page cache and reclaimable slab filling the VM that allocation failed on 2026-10-22 at 07:49Z and 13:22Z
(hvs_probe -> vmbus_open -> vmbus_alloc_ring), the relay of that wsl.exe hung and two trivy stages ended
UNCERTAIN. The drop-in (60-clued-ci-hvsock-memory.conf):
  net.core.rmem_default = net.core.wmem_default = 65536  -> new rings 2 x 16 pages = order 5 (128 KiB)
  vm.watermark_scale_factor = 200                        -> kswapd wakes earlier and keeps ~2% of each zone free
  vm.watermark_boost_factor = 3500                       -> the boost cap scales with the high watermark; this
                                                            keeps its absolute size where it is today

Sub-commands (each prints one JSON object; exit 0 only on success):
  plan --conf FILE                    read-only: live values, target values, drop-in state, boot overrides,
                                      planSha256
  apply --conf FILE --plan SHA256     root: refuses while a clued-ci unit runs, when another sysctl file would
                                      override a key at boot, or when an earlier apply was not rolled back;
                                      saves the live values and the existing hv_sock devices, creates the drop-in
                                      (create-only, never overwritten) and writes the values to /proc/sys
  verify --conf FILE [--saved FILE]   read-only: drop-in bytes and live values equal FILE; ring sizes of the
                                      hv_sock devices opened after that apply
  rollback --saved FILE               root: writes the saved values back and moves the drop-in that apply created
                                      aside (renamed into the state directory, never deleted); the saved file is
                                      then renamed rolled-back-*.json
The memory guard (clued-wsl-memguard + .service + .timer: one pass every 60 s, also inside a batch) is installed
the same way, from the directory holding those three files:
  guard-plan --pkg DIR                read-only: file states, planSha256
  guard-apply --pkg DIR --plan SHA    root: create-only install, daemon-reload, enable --now the timer, one pass
  guard-verify --pkg DIR              read-only: files equal DIR, timer enabled and active, last pass succeeded
  guard-rollback --saved FILE         root: disable --now the timer, move the files it installed aside
Run it from a root-owned copy (README.md): the plan binds this file's and the drop-in's SHA-256.
"""
import datetime
import hashlib
import json
import os
import re
import secrets
import stat
import subprocess
import sys

REAL = {
    'proc_sys': '/proc/sys',
    'target': '/etc/sysctl.d/60-clued-ci-hvsock-memory.conf',
    'state': '/var/lib/clued-wsl-host-tuning',
    'hv_sock': '/sys/bus/vmbus/drivers/hv_sock',
    'buddyinfo': '/proc/buddyinfo',
    'zoneinfo': '/proc/zoneinfo',
    # systemd-sysctl search path, highest priority first (sysctl.d(5)); /etc/sysctl.conf comes in through
    # Ubuntu's /etc/sysctl.d/99-sysctl.conf link.
    'sysctl_dirs': ('/etc/sysctl.d', '/run/sysctl.d', '/usr/local/lib/sysctl.d', '/usr/lib/sysctl.d', '/lib/sysctl.d'),
    'guard_files': (('clued-wsl-memguard', '/usr/local/lib/clued-wsl-host-tuning/clued-wsl-memguard', 0o755),
                    ('clued-wsl-memguard.service', '/etc/systemd/system/clued-wsl-memguard.service', 0o644),
                    ('clued-wsl-memguard.timer', '/etc/systemd/system/clued-wsl-memguard.timer', 0o644)),
}
# Write order: the boost factor drops before the scale factor raises the high watermark it multiplies, and
# rollback restores in the opposite order, so the boost cap never briefly grows.
APPLY_ORDER = ('vm.watermark_boost_factor', 'vm.watermark_scale_factor', 'net.core.rmem_default', 'net.core.wmem_default')
ROLLBACK_ORDER = ('vm.watermark_scale_factor', 'vm.watermark_boost_factor', 'net.core.rmem_default', 'net.core.wmem_default')
GUARD_SERVICE, GUARD_TIMER = 'clued-wsl-memguard.service', 'clued-wsl-memguard.timer'
GUARD_CONTRACT = 'clued.wsl-host-tuning-guard-previous/1'
MAX_GUARD_FILE = 65536
SYSTEMCTL = '/usr/bin/systemctl'
ENV = {'PATH': '/usr/bin:/bin', 'LANG': 'C', 'LC_ALL': 'C'}
PAGE = 4096
# hv_sock keeps each ring direction between 6 and 64 pages (net/vmw_vsock/hyperv_transport.c RINGBUFFER_HVS_*).
HVS_MIN, HVS_MAX = 6 * PAGE, 64 * PAGE
BOUNDS = {'net.core.rmem_default': (HVS_MIN, HVS_MAX), 'net.core.wmem_default': (HVS_MIN, HVS_MAX),
          'vm.watermark_scale_factor': (10, 1000), 'vm.watermark_boost_factor': (0, 15000)}
KEYS = tuple(BOUNDS)
MAX_CONF = 4096
MAX_SAVED = 65536
SAVED_CONTRACT = 'clued.wsl-host-tuning-previous/2'
DEVICE = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
CONF_LINE = re.compile(r'^([a-z_.]+)\s*=\s*([0-9]{1,7})$')
CI_UNIT = re.compile(r'^(clued-ci-[a-z]+@\S+\.service)\s+\S+\s+(\S+)\s+(\S+)')
BINARY = getattr(os, 'O_BINARY', 0)  # 0 on Linux; keeps the offline tests on Windows byte-exact


class Refused(Exception):
    def __init__(self, code, detail=None):
        super().__init__(code)
        self.code = code
        self.detail = detail


def need(cond, code, detail=None):
    if not cond:
        raise Refused(code, detail)


def sha256(raw):
    return hashlib.sha256(raw).hexdigest()


# ---------- pure helpers (unit-tested on any OS) ----------

def parse_conf(raw):
    """Exactly the four keys, once each, decimal values within BOUNDS; comments and blank lines only otherwise.
    No '-' prefix, no other key: what is reviewed is all the drop-in can set."""
    need(isinstance(raw, bytes) and 0 < len(raw) <= MAX_CONF, 'CONF_REFUSED')
    try:
        text = raw.decode('ascii')
    except UnicodeDecodeError:
        raise Refused('CONF_REFUSED')
    values = {}
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith('#'):
            continue
        m = CONF_LINE.fullmatch(s)
        need(m is not None and m.group(1) in BOUNDS and m.group(1) not in values, 'CONF_REFUSED')
        values[m.group(1)] = int(m.group(2))
    need(set(values) == set(KEYS), 'CONF_REFUSED')
    for key, (lo, hi) in BOUNDS.items():
        need(lo <= values[key] <= hi, 'CONF_REFUSED')
    need(values['net.core.rmem_default'] % PAGE == 0 and values['net.core.wmem_default'] % PAGE == 0, 'CONF_REFUSED')
    return values


def ring_bytes(sock_buf):
    """One direction of a host-initiated hv_sock channel: the socket buffer clamped to 6..64 pages, page aligned."""
    size = min(max(sock_buf, HVS_MIN), HVS_MAX)
    return -(-size // PAGE) * PAGE


def ring_order(rmem, wmem):
    """Buddy order of the single allocation holding both directions (vmbus_alloc_ring)."""
    pages = (ring_bytes(wmem) + ring_bytes(rmem)) // PAGE
    return (pages - 1).bit_length()


def proc_path(proc_sys, key):
    need(key in BOUNDS, 'KEY_REFUSED')
    return f"{proc_sys}/{key.replace('.', '/')}"


def file_state(current, wanted):
    if current is None:
        return 'absent'
    return 'same' if current == wanted else 'different'


def sysctl_keys(text):
    """(key, kind) for each line of a sysctl.d file, normalised the way systemd-sysctl reads them ('/' separators,
    '-' prefix): kind 'set' for an assignment, 'exclude' for a bare '-key' line, which keeps the key from being set."""
    keys = []
    for line in text.splitlines():
        s = line.strip()
        if not s or s[0] in '#;':
            continue
        if '=' in s:
            keys.append((s.split('=', 1)[0].strip().lstrip('-').replace('/', '.'), 'set'))
        elif s.startswith('-'):
            keys.append((s[1:].strip().replace('/', '.'), 'exclude'))
    return keys


def boot_overrides(files, target_name):
    """files: {basename: text} as systemd-sysctl would pick them (first directory wins per basename). Entries are
    read in basename order and a later entry for the same exact name replaces an earlier one (systemd 255
    src/sysctl/sysctl.c): so a later file that assigns one of our keys overrides the drop-in, and a later bare
    '-key' line with exactly our key leaves it unset at boot. Globs, assigned or negated, never touch an explicit
    key, and anything sorting before the drop-in is replaced by it."""
    found = []
    for name in sorted(files):
        if name <= target_name:
            continue
        for key, kind in sysctl_keys(files[name]):
            if key in KEYS:
                found.append(f'{name}:{key}' if kind == 'set' else f'{name}:-{key}')
    return sorted(set(found))


def plan_text(tool_sha, conf_raw, live, state, kernel, target, overrides):
    conf = parse_conf(conf_raw)
    lines = [f'tool.sha256={tool_sha}', f'conf.sha256={sha256(conf_raw)}', f'target={target}', f'dropIn={state}', f'kernel={kernel}']
    lines += [f'conf.{k}={conf[k]}' for k in KEYS] + [f'live.{k}={live[k]}' for k in KEYS]
    lines += [f'bootOverride={o}' for o in overrides]
    return '\n'.join(lines) + '\n'


def plan_sha(text):
    return sha256(text.encode('ascii'))


def busy_units(listing):
    """clued-ci-* units that are not inactive/failed (systemctl list-units --all --plain --no-legend)."""
    busy = []
    for line in listing.splitlines():
        m = CI_UNIT.match(line.strip())
        if m and m.group(2) not in ('inactive', 'failed'):
            busy.append(m.group(1))
    return busy


def ring_histogram(sizes):
    hist = {}
    for s in sizes:
        hist[str(s)] = hist.get(str(s), 0) + 1
    return dict(sorted(hist.items(), key=lambda kv: int(kv[0])))


def ring_verdict(rings, before, expected, old):
    """rings: {device: send-ring data bytes}. Only devices opened after apply (not in before) count. True as soon as
    one shows the new size: a listener created after the change uses it. Old-size channels can still appear next
    to them (listeners WSL creates at boot before systemd-sysctl runs, or before apply), so they do not turn the
    answer to None. False when new devices show only the old size: the relay sets its own buffers. None when
    nothing new was opened yet or the sizes say neither."""
    new = [size for dev, size in rings.items() if dev not in before]
    at_new, at_old = new.count(expected), (new.count(old) if old != expected else 0)
    if at_new:
        return True, ring_histogram(new)
    if at_old:
        return False, ring_histogram(new)
    return None, ring_histogram(new)


def buddy_summary(text):
    """Free blocks of at least order 5 and order 7 per zone, from /proc/buddyinfo."""
    out = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 15 and parts[0] == 'Node' and parts[2] == 'zone':
            counts = [int(x) for x in parts[4:15]]
            out[f'{parts[1].rstrip(",")}:{parts[3]}'] = {'order5plus': sum(counts[5:]), 'order7plus': sum(counts[7:])}
    return out


def zone_summary(text):
    """free, boost, min, low, high (pages) per zone, from /proc/zoneinfo."""
    out, zone = {}, None
    for line in text.splitlines():
        parts = line.split()
        if line.startswith('Node') and len(parts) >= 4 and parts[2] == 'zone':
            zone = parts[3]
            out[zone] = {}
        elif zone and len(parts) >= 2 and parts[0] in ('min', 'low', 'high', 'boost') and parts[1].isdigit():
            out[zone][parts[0]] = int(parts[1])
        elif zone and len(parts) >= 3 and parts[:2] == ['pages', 'free']:
            out[zone]['free'] = int(parts[2])
    return {z: v for z, v in out.items() if v.get('high')}


def validate_saved(saved):
    need(isinstance(saved, dict) and saved.get('contract') == SAVED_CONTRACT, 'SAVED_REFUSED')
    values = saved.get('values')
    need(isinstance(values, dict) and set(values) == set(KEYS), 'SAVED_REFUSED')
    need(all(type(values[k]) is int and 0 <= values[k] <= 10**8 for k in KEYS), 'SAVED_REFUSED')
    need(saved.get('dropInBefore') in ('absent', 'same'), 'SAVED_REFUSED')
    need(isinstance(saved.get('confSha256'), str) and re.fullmatch(r'[0-9a-f]{64}', saved['confSha256']), 'SAVED_REFUSED')
    devices = saved.get('devicesBefore')
    need(isinstance(devices, list) and all(isinstance(d, str) and DEVICE.fullmatch(d) for d in devices), 'SAVED_REFUSED')
    return saved


# ---------- host effects (paths injectable for the offline tests) ----------

def read_optional(path, limit=MAX_CONF):
    try:
        fd = os.open(path, os.O_RDONLY | BINARY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_CLOEXEC', 0))
    except FileNotFoundError:
        return None
    try:
        st = os.fstat(fd)
        need(stat.S_ISREG(st.st_mode) and st.st_size <= limit, 'FILE_SHAPE_REFUSED')
        raw = os.read(fd, limit + 1)
        need(len(raw) == st.st_size, 'FILE_SHAPE_REFUSED')
        return raw
    finally:
        os.close(fd)


def read_required(path, limit=MAX_CONF):
    raw = read_optional(path, limit)
    need(raw is not None, 'FILE_MISSING')
    return raw


def read_live(proc_sys):
    values = {}
    for k in KEYS:
        with open(proc_path(proc_sys, k)) as f:
            values[k] = int(f.read().split()[0])
    return values


def write_value(proc_sys, key, value):
    with open(proc_path(proc_sys, key), 'w') as f:
        f.write(f'{int(value)}\n')


def read_rings(hv_sock):
    """{device: out_read_bytes_avail + out_write_bytes_avail}: the send ring's data size, whatever is queued in it."""
    rings = {}
    try:
        devices = sorted(os.listdir(hv_sock))
    except FileNotFoundError:
        return rings
    for dev in devices:
        if not DEVICE.fullmatch(dev):
            continue
        try:
            with open(f'{hv_sock}/{dev}/out_read_bytes_avail') as r, open(f'{hv_sock}/{dev}/out_write_bytes_avail') as w:
                rings[dev] = int(r.read().strip()) + int(w.read().strip())
        except (OSError, ValueError):
            continue
    return rings


def device_ids(hv_sock):
    try:
        return sorted(d for d in os.listdir(hv_sock) if DEVICE.fullmatch(d))
    except FileNotFoundError:
        return []


def sysctl_files(dirs):
    """{basename: text} the way systemd-sysctl picks them; symlinks are followed (99-sysctl.conf), read-only."""
    files = {}
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except (FileNotFoundError, NotADirectoryError):
            continue
        for name in names:
            if not name.endswith('.conf') or name in files:
                continue
            try:
                with open(f'{d}/{name}', encoding='utf-8', errors='replace') as f:
                    files[name] = f.read(1 << 20)
            except OSError:
                files[name] = ''
    return files


def _fsync_dir(path):
    if not hasattr(os, 'O_DIRECTORY'):
        return  # Windows (offline tests): no directory handles
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _durable_new(path, value):
    with open(path, 'x') as f:
        json.dump(value, f, sort_keys=True)
        f.flush()
        os.fsync(f.fileno())
    _fsync_dir(os.path.dirname(path))


def _create_only(path, raw, mode):
    """Write a temporary name in the same directory, then hard-link it to the final name: link() fails if the
    final name exists, so an existing drop-in is never replaced."""
    tmp = f'{os.path.dirname(path)}/.{os.path.basename(path)}.new-{secrets.token_hex(6)}'
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | BINARY | getattr(os, 'O_NOFOLLOW', 0), mode)
    try:
        os.write(fd, raw)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.chmod(tmp, mode)
    try:
        os.link(tmp, path)
    except FileExistsError:
        raise Refused('DROP_IN_APPEARED')
    finally:
        os.unlink(tmp)
    _fsync_dir(os.path.dirname(path))


def saved_files(state):
    """Saved files of applies not rolled back yet (rollback renames them rolled-back-*.json)."""
    try:
        return sorted(n for n in os.listdir(state) if n.startswith('previous-') and n.endswith('.json'))
    except FileNotFoundError:
        return []


def plan_tuning(p, conf_raw, tool_sha, kernel):
    parse_conf(conf_raw)
    live = read_live(p['proc_sys'])
    state = file_state(read_optional(p['target']), conf_raw)
    overrides = boot_overrides(sysctl_files(p['sysctl_dirs']), os.path.basename(p['target']))
    text = plan_text(tool_sha, conf_raw, live, state, kernel, p['target'], overrides)
    return text, live, state, overrides


def apply_tuning(p, conf_raw, want_plan, tool_sha, kernel, busy, stamp):
    target = parse_conf(conf_raw)
    text, live, state, overrides = plan_tuning(p, conf_raw, tool_sha, kernel)
    need(plan_sha(text) == want_plan, 'PLAN_CHANGED_SINCE_REVIEW')
    need(not busy, 'CI_UNIT_ACTIVE')
    need(state != 'different', 'DROP_IN_DIFFERS_OWNER_DECIDES')
    need(not overrides, 'KEY_OVERRIDDEN_AT_BOOT')
    if state == 'same' and live == target:
        return {'status': 'HOST_TUNING_ALREADY_APPLIED', 'now': live, 'planSha256': want_plan}
    # A drop-in that is there together with an earlier saved file means an apply that did not finish (or values
    # changed since): roll that one back first, so there is only ever one saved file that restores the original.
    need(not (state == 'same' and saved_files(p['state'])), 'PREVIOUS_APPLY_NOT_ROLLED_BACK', saved_files(p['state']))
    os.makedirs(p['state'], mode=0o700, exist_ok=True)
    saved = f"{p['state']}/previous-{stamp}.json"
    _durable_new(saved, {'contract': SAVED_CONTRACT, 'values': live, 'dropInBefore': state, 'confSha256': sha256(conf_raw),
                         'planSha256': want_plan, 'devicesBefore': device_ids(p['hv_sock'])})
    if state == 'absent':
        _create_only(p['target'], conf_raw, 0o644)
    for k in APPLY_ORDER:
        write_value(p['proc_sys'], k, target[k])
    now = read_live(p['proc_sys'])
    need(now == target, 'APPLY_READBACK_MISMATCH')
    return {'status': 'HOST_TUNING_APPLIED', 'saved': saved, 'previous': live, 'now': now,
            'dropIn': 'created' if state == 'absent' else 'already-present', 'planSha256': want_plan}


def load_saved(p, saved_path):
    real_state = os.path.realpath(p['state'])
    need(os.path.dirname(os.path.realpath(saved_path)) == real_state, 'SAVED_OUTSIDE_STATE')
    return validate_saved(json.loads(read_required(saved_path, MAX_SAVED)))


def verify_tuning(p, conf_raw, saved_path=None):
    target = parse_conf(conf_raw)
    state = file_state(read_optional(p['target']), conf_raw)
    live = read_live(p['proc_sys'])
    overrides = boot_overrides(sysctl_files(p['sysctl_dirs']), os.path.basename(p['target']))
    ok = state == 'same' and live == target and not overrides
    saved = load_saved(p, saved_path) if saved_path else None
    rings = read_rings(p['hv_sock'])
    expected = ring_bytes(target['net.core.wmem_default']) - PAGE
    old = ring_bytes(saved['values']['net.core.wmem_default']) - PAGE if saved else ring_bytes(212992) - PAGE
    effective, new_hist = ring_verdict(rings, set(saved['devicesBefore']) if saved else set(), expected, old)
    return {'status': 'HOST_TUNING_VERIFIED' if ok else 'HOST_TUNING_NOT_IN_EFFECT', 'dropIn': state, 'live': live,
            'bootOverrides': overrides, 'ringOrderForNewChannels': ring_order(live['net.core.rmem_default'], live['net.core.wmem_default']),
            'expectedNewRingBytes': expected, 'ringEffective': effective if ok else None,
            'newDeviceRingBytes': new_hist, 'allDeviceRingBytes': ring_histogram(rings.values())}, ok


def rollback_tuning(p, saved_path, stamp):
    saved = load_saved(p, saved_path)
    moved = None
    if saved['dropInBefore'] == 'absent' and os.path.lexists(p['target']):
        current = read_optional(p['target'])
        need(current is not None and sha256(current) == saved['confSha256'], 'DROP_IN_CHANGED_SINCE_APPLY')
        moved = f"{p['state']}/removed-{stamp}-{os.path.basename(p['target'])}"
        need(not os.path.lexists(moved), 'ROLLBACK_NAME_TAKEN')
        os.rename(p['target'], moved)  # /etc and /var/lib share the WSL root file system
        _fsync_dir(os.path.dirname(p['target']))
    for k in ROLLBACK_ORDER:
        write_value(p['proc_sys'], k, saved['values'][k])
    now = read_live(p['proc_sys'])
    need(now == saved['values'], 'ROLLBACK_READBACK_MISMATCH')
    retired = f"{os.path.dirname(saved_path)}/rolled-back-{os.path.basename(saved_path)}"
    os.rename(saved_path, retired)  # a later apply no longer counts it as an unfinished one
    _fsync_dir(os.path.dirname(saved_path))
    return {'status': 'HOST_TUNING_ROLLED_BACK', 'now': now, 'dropInMovedTo': moved, 'savedRetiredAs': retired}


# ---------- memory guard install ----------

def guard_package(p, pkg_dir):
    return {name: read_required(f'{pkg_dir}/{name}', MAX_GUARD_FILE) for name, _, _ in p['guard_files']}


def guard_states(p, pkg):
    return {name: file_state(read_optional(target, MAX_GUARD_FILE), pkg[name]) for name, target, _ in p['guard_files']}


def guard_plan(p, pkg_dir, tool_sha, kernel):
    pkg = guard_package(p, pkg_dir)
    states = guard_states(p, pkg)
    lines = [f'tool.sha256={tool_sha}', f'kernel={kernel}']
    lines += [f'guard.{name}.sha256={sha256(pkg[name])}' for name, _, _ in p['guard_files']]
    lines += [f'guard.{name}.target={target}:{mode:o}:{states[name]}' for name, target, mode in p['guard_files']]
    return '\n'.join(lines) + '\n', pkg, states


def guard_saved_files(state):
    try:
        return sorted(n for n in os.listdir(state) if n.startswith('guard-previous-') and n.endswith('.json'))
    except FileNotFoundError:
        return []


def guard_running(systemctl):
    code, out = systemctl('is-active', GUARD_TIMER)
    return code == 0 and out.strip() == 'active'


def guard_timer_state(systemctl):
    """(is-enabled, is-active) words of the timer, as systemctl prints them ('not-found' when it does not exist)."""
    return systemctl('is-enabled', GUARD_TIMER)[1].strip() or 'unknown', systemctl('is-active', GUARD_TIMER)[1].strip() or 'unknown'


def guard_last_pass_ok(systemctl):
    """The service unit is loaded, has run at least once, and its last pass succeeded (Result=success alone is
    also what systemd reports for a unit that never ran or does not exist)."""
    code, out = systemctl('show', '--property=LoadState,Result,ExecMainStartTimestampMonotonic', GUARD_SERVICE)
    facts = dict(line.split('=', 1) for line in out.splitlines() if '=' in line)
    return (code == 0 and facts.get('LoadState') == 'loaded' and facts.get('Result') == 'success'
            and facts.get('ExecMainStartTimestampMonotonic', '0') not in ('', '0'))


def guard_apply(p, pkg_dir, want_plan, tool_sha, kernel, busy, stamp, systemctl):
    text, pkg, states = guard_plan(p, pkg_dir, tool_sha, kernel)
    need(plan_sha(text) == want_plan, 'PLAN_CHANGED_SINCE_REVIEW')
    need(not busy, 'CI_UNIT_ACTIVE')
    need('different' not in states.values(), 'GUARD_FILE_DIFFERS_OWNER_DECIDES')
    if all(v == 'same' for v in states.values()) and guard_running(systemctl) and guard_last_pass_ok(systemctl):
        return {'status': 'GUARD_ALREADY_APPLIED', 'planSha256': want_plan}
    need(not guard_saved_files(p['state']), 'PREVIOUS_GUARD_APPLY_NOT_ROLLED_BACK', guard_saved_files(p['state']))
    enabled, active = guard_timer_state(systemctl)
    os.makedirs(p['state'], mode=0o700, exist_ok=True)
    saved = f"{p['state']}/guard-previous-{stamp}.json"
    _durable_new(saved, {'contract': GUARD_CONTRACT, 'states': states, 'sha256': {n: sha256(raw) for n, raw in pkg.items()},
                         'timerBefore': {'enabled': enabled, 'active': active}, 'planSha256': want_plan})
    for name, target, mode in p['guard_files']:
        if states[name] == 'absent':
            os.makedirs(os.path.dirname(target), mode=0o755, exist_ok=True)
            _create_only(target, pkg[name], mode)
    for args in (('daemon-reload',), ('enable', '--now', GUARD_TIMER)):
        code, _ = systemctl(*args)
        need(code == 0, 'GUARD_SYSTEMCTL_FAILED', ' '.join(args))
    code, _ = systemctl('start', GUARD_SERVICE)
    if code != 0 or not (guard_running(systemctl) and guard_last_pass_ok(systemctl)):
        systemctl('disable', '--now', GUARD_TIMER)  # a guard that cannot do its pass must not keep failing every minute
        raise Refused('GUARD_FIRST_RUN_FAILED', saved)
    return {'status': 'GUARD_APPLIED', 'saved': saved, 'states': states, 'planSha256': want_plan}


def guard_verify(p, pkg_dir, systemctl):
    states = guard_states(p, guard_package(p, pkg_dir))
    enabled, _ = guard_timer_state(systemctl)
    running, last_ok = guard_running(systemctl), guard_last_pass_ok(systemctl)
    ok = all(v == 'same' for v in states.values()) and enabled == 'enabled' and running and last_ok
    return {'status': 'GUARD_VERIFIED' if ok else 'GUARD_NOT_IN_EFFECT', 'states': states, 'timerEnabled': enabled,
            'timerActive': running, 'lastPassSucceeded': last_ok}, ok


def guard_rollback(p, saved_path, stamp, systemctl):
    real_state = os.path.realpath(p['state'])
    need(os.path.dirname(os.path.realpath(saved_path)) == real_state, 'SAVED_OUTSIDE_STATE')
    saved = json.loads(read_required(saved_path, MAX_SAVED))
    names = [name for name, _, _ in p['guard_files']]
    timer_before = saved.get('timerBefore') if isinstance(saved, dict) else None
    need(isinstance(saved, dict) and saved.get('contract') == GUARD_CONTRACT and isinstance(saved.get('states'), dict)
         and isinstance(saved.get('sha256'), dict) and set(saved['states']) == set(names) == set(saved['sha256'])
         and all(saved['states'][n] in ('absent', 'same') for n in names)
         and isinstance(timer_before, dict) and isinstance(timer_before.get('enabled'), str) and isinstance(timer_before.get('active'), str), 'SAVED_REFUSED')
    created = [(name, target) for name, target, _ in p['guard_files'] if saved['states'][name] == 'absent' and os.path.lexists(target)]
    for name, target in created:  # every file is checked before anything is touched
        current = read_optional(target, MAX_GUARD_FILE)
        need(current is not None and sha256(current) == saved['sha256'][name], 'GUARD_FILE_CHANGED_SINCE_APPLY', name)
    # Back to the timer state recorded before apply: off unless it was an enabled, running install before.
    was_on = timer_before['enabled'] == 'enabled' and timer_before['active'] == 'active' and not created
    if not was_on:
        code, _ = systemctl('disable', '--now', GUARD_TIMER)
        need(code == 0 or not any(os.path.lexists(t) for _, t, _ in p['guard_files']), 'GUARD_SYSTEMCTL_FAILED', 'disable --now')
    systemctl('reset-failed', GUARD_SERVICE)
    moved = []
    for name, target in created:
        dest = f"{p['state']}/removed-{stamp}-{name}"
        need(not os.path.lexists(dest), 'ROLLBACK_NAME_TAKEN')
        os.rename(target, dest)  # /usr/local/lib, /etc and /var/lib share the WSL root file system
        _fsync_dir(os.path.dirname(target))
        moved.append(dest)
    systemctl('daemon-reload')
    retired = f"{os.path.dirname(saved_path)}/rolled-back-{os.path.basename(saved_path)}"
    os.rename(saved_path, retired)
    _fsync_dir(os.path.dirname(saved_path))
    return {'status': 'GUARD_ROLLED_BACK', 'movedTo': moved, 'savedRetiredAs': retired}


def run_systemctl(*args):
    r = subprocess.run([SYSTEMCTL, *args], env=ENV, capture_output=True, text=True, timeout=120, check=False)
    return r.returncode, r.stdout


def list_units():
    r = subprocess.run([SYSTEMCTL, 'list-units', '--all', '--plain', '--no-legend', 'clued-ci-*'], env=ENV, capture_output=True, text=True, timeout=30, check=False)
    need(r.returncode == 0, 'SYSTEMCTL_LIST_UNCONFIRMED')
    return r.stdout


def memory_facts(p):
    """Free blocks and per-zone watermarks/boost, for the observation record. /proc files report size 0, so they
    are read plainly rather than through read_optional."""
    facts = {}
    for key, path, parse in (('buddy', p['buddyinfo'], buddy_summary), ('zones', p['zoneinfo'], zone_summary)):
        try:
            with open(path) as f:
                facts[key] = parse(f.read())
        except OSError:
            facts[key] = None
    try:
        with open('/sys/module/page_reporting/parameters/page_reporting_order') as f:
            facts['pageReportingOrder'] = int(f.read().strip())
    except (OSError, ValueError):
        facts['pageReportingOrder'] = None
    return facts


def is_root():
    return hasattr(os, 'geteuid') and os.geteuid() == 0


def main(argv, p=REAL):
    cmd = argv[0] if argv else ''
    args = dict(zip(argv[1::2], argv[2::2]))
    need(cmd in ('plan', 'apply', 'verify', 'rollback', 'guard-plan', 'guard-apply', 'guard-verify', 'guard-rollback'), 'COMMAND_REFUSED')
    need(cmd not in ('apply', 'rollback', 'guard-apply', 'guard-rollback') or is_root(), 'ROOT_REQUIRED')
    tool_sha = sha256(read_required(os.path.realpath(__file__), 1 << 20))
    kernel = os.uname().release if hasattr(os, 'uname') else 'unknown'
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + secrets.token_hex(3)
    if cmd == 'plan':
        conf_raw = read_required(args.get('--conf', ''))
        text, _, _, overrides = plan_tuning(p, conf_raw, tool_sha, kernel)
        return {'status': 'DRY_RUN_PLAN_ONLY_NOTHING_WRITTEN', 'planSha256': plan_sha(text), 'plan': text.splitlines(),
                'bootOverrides': overrides, 'busyUnits': busy_units(list_units()), 'memory': memory_facts(p)}, True
    if cmd == 'apply':
        conf_raw = read_required(args.get('--conf', ''))
        return apply_tuning(p, conf_raw, args.get('--plan', ''), tool_sha, kernel, busy_units(list_units()), stamp), True
    if cmd == 'verify':
        result, ok = verify_tuning(p, read_required(args.get('--conf', '')), args.get('--saved'))
        return {**result, 'memory': memory_facts(p)}, ok
    if cmd == 'rollback':
        return rollback_tuning(p, args.get('--saved', ''), stamp), True
    if cmd == 'guard-plan':
        text, _, states = guard_plan(p, args.get('--pkg', ''), tool_sha, kernel)
        return {'status': 'DRY_RUN_PLAN_ONLY_NOTHING_WRITTEN', 'planSha256': plan_sha(text), 'plan': text.splitlines(),
                'states': states, 'busyUnits': busy_units(list_units())}, True
    if cmd == 'guard-apply':
        return guard_apply(p, args.get('--pkg', ''), args.get('--plan', ''), tool_sha, kernel, busy_units(list_units()), stamp, run_systemctl), True
    if cmd == 'guard-verify':
        return guard_verify(p, args.get('--pkg', ''), run_systemctl)
    return guard_rollback(p, args.get('--saved', ''), stamp, run_systemctl), True


if __name__ == '__main__':
    try:
        result, ok = main(sys.argv[1:])
        print(json.dumps(result, sort_keys=True))
        sys.exit(0 if ok else 1)
    except Refused as e:
        print(json.dumps({'status': 'REFUSED', 'code': e.code, **({'detail': e.detail} if e.detail else {})}))
        sys.exit(1)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as e:
        print(json.dumps({'status': 'REFUSED', 'code': 'HOST_TUNING_UNCONFIRMED', 'kind': type(e).__name__}))
        sys.exit(1)
