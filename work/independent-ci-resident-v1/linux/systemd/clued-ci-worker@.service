# Resident independent CI: one Linux scanner job (gitleaks / trivy / contract-placement). DRAFT.
# Instance = the 64-hex job id named by incoming/issue.json. Started only by the companion
# (systemctl start --no-block clued-ci-worker@<jobId>.service); it runs the existing, unchanged
# protected-job-bridge-v4/linux-worker.mjs (Source v2) under the pinned toolchain node (S10: the same node the role-v3 policies and the relay require), but supervised by
# systemd so that "every process of this job has exited" is provable from the unit's cgroup.
#
# No timeout kill and no automatic restart: the worker's own deadlines end the job; a hung job stays
# visible (active) and the Windows side classifies it UNKNOWN -> HALT. Nothing here ever kills it.
[Unit]
Description=Clued independent CI Linux job %i
After=docker.service
# Wants=, not Requires=: a docker stop or restart must not propagate a stop (SIGTERM) to the job.
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# The guard re-checks the pins of everything below, that incoming/issue.json exists and names this
# job, and that no other clued-ci unit is active (systemd Conflicts= cannot name templates).
# A refusal fails the unit visibly before the worker starts.
ExecStartPre=/opt/clued-independent-ci/resident-v1/bin/clued-ci-resident-linux guard --unit worker --instance %i
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin HOME=/root LANG=C LC_ALL=C /var/lib/clued-independent-ci/toolchain-build-legacy-v1/node /opt/clued-independent-ci/source-v2/work/actions-hosted-migration/independent-ci-v1/worker/protected-job-bridge-v4/linux-worker.mjs --run
TimeoutStartSec=infinity
Restart=no
RemainAfterExit=no
KillMode=control-group
SendSIGKILL=no
# Hardening (each item to be confirmed in the offline rehearsal; the worker needs the docker socket,
# its root-owned state and the Ed25519 result key, nothing else).
NoNewPrivileges=yes
ProtectSystem=strict
# The trivy role's cache root (Source manifest roles.trivy.formalTrivy.cacheRoot) is a sibling of the
# state root, not inside it: the role takes its prepare.lock there and stages and promotes the DB and
# checks generations. Without it the cache is read-only here and every trivy job ends before its first
# container (EROFS on prepare.lock). The '-' keeps a missing cache root from failing every worker unit at
# namespace setup: gitleaks and placement are unaffected, and a trivy job then ends UNCERTAIN (its role
# session checks the cache root as a protected path), which halts the resident: fail closed.
ReadWritePaths=/var/lib/clued-independent-ci -/var/lib/clued-independent-ci-trivy-cache
# L2 (DESIGN 65.2): every run gets a view built when the unit starts and gone when its last process exits, success or failure.
# Each Exec line builds it again from these settings. It shows only what this one job uses:
#   - formal-spool: an empty read-only tmpfs with the live incoming/ and outgoing/ bound back in (the relay keeps writing
#     responses into incoming/ during the job; outgoing/ takes challenges, the result and active.lock). Earlier batches'
#     archive-*/failed-*/completed-* directories are not there;
#   - workspaces: an empty read-only tmpfs with only this job's own workspaces/<jobId> (%i, which the guard checks against the
#     issue) bound back in, writable as before. Other jobs' and batches' workspaces are not there;
#   - the toolchain node is read-only (a mount point: the writable state root cannot rename it away); the resident tool's state
#     and the legacy state directories are not there; /mnt (drvfs) is an empty tmpfs and /run/WSL (interop) is not there.
# Unchanged on purpose: the state root stays writable (the Source's SERIAL_LOCK /var/lib/clued-independent-ci/formal-role.lock
# must land on disk for the archive and ws-prep), runs/ and the trivy cache root stay real paths (dockerd resolves every bind
# source in the host namespace, and the cache is kept across batches). Every path is '-': a missing one does not fail the unit at
# namespace setup; the worker's own checks refuse it exactly as before.
TemporaryFileSystem=/var/lib/clued-independent-ci/formal-spool:ro,mode=0755,nosuid,nodev,noexec
BindPaths=-/var/lib/clued-independent-ci/formal-spool/incoming -/var/lib/clued-independent-ci/formal-spool/outgoing
TemporaryFileSystem=/var/lib/clued-independent-ci/workspaces:ro,mode=0700,nosuid,nodev,noexec
BindPaths=-/var/lib/clued-independent-ci/workspaces/%i
TemporaryFileSystem=/mnt:ro,mode=0755,nosuid,nodev,noexec
ReadOnlyPaths=-/var/lib/clued-independent-ci/toolchain-build-legacy-v1
InaccessiblePaths=-/var/lib/clued-independent-ci/resident -/var/lib/clued-independent-ci/verify-spool -/var/lib/clued-independent-ci/verify-once-state -/var/lib/clued-independent-ci/trusted-source -/run/WSL
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
StandardOutput=journal
StandardError=journal
