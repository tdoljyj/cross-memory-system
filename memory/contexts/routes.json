{
  "schema_version": 1,
  "route_id": "current_work",
  "description": "Deterministic low-cost route for personal or project-related questions about current work, todos, priorities, progress, or the next action.",
  "precondition": "The request is T1/T2 personal or project related. T0 generic questions remain Memory Access = NONE.",
  "match": {
    "mode": "substring_any",
    "case_insensitive": true,
    "terms": [
      "我现在要做的有哪些",
      "现在最需要做什么",
      "当前待办",
      "要做什么",
      "待办",
      "下一步",
      "优先级",
      "项目进度",
      "what should i work on",
      "current tasks",
      "next action",
      "priority",
      "project progress"
    ]
  },
  "required_sources": [
    {
      "path": "memory/状态.md",
      "role": "current_state"
    },
    {
      "path": "memory/待办.md",
      "role": "todos"
    },
    {
      "path": "memory/决策.md",
      "role": "decisions_and_constraints"
    }
  ],
  "authorized_context_sources": [
    {
      "context_key": "project:clued",
      "path": "memory/contexts/projects/clued/日志.md",
      "required_when_authorized_and_relevant": true
    }
  ],
  "answer_contract": {
    "required_fields": [
      "current_priority",
      "current_todos",
      "conflicts",
      "next_action",
      "sources_read"
    ],
    "project_log_replaces_global_memory": false,
    "surface_conflicts": true,
    "fail_closed_when_required_source_is_unavailable": true
  },
  "semantic_contract": {
    "version": "clued-v1.6-m1",
    "read_order": [
      "global_registry_and_priority",
      "project_state_task_decision",
      "log_and_archive_on_demand"
    ],
    "current_truth": [
      "state",
      "task",
      "decision"
    ],
    "history_on_demand": [
      "log",
      "archive"
    ],
    "write_order": [
      "canonical_entity",
      "event_and_receipt_same_transaction",
      "derived_views"
    ],
    "canonical_id_field": "id",
    "mirror_mode": "query_results_or_stable_id_references",
    "mirror_layout": {
      "global_directory": "Global",
      "project_directory_pattern": "Projects/{canonical_project_id}",
      "view_files": [
        "State.md",
        "Task.md",
        "Decision.md",
        "Archive.md",
        "Log.md"
      ],
      "entry_mode": "query_conclusion_or_stable_id_reference",
      "entry_template": "- `{id}` — {title}: {conclusion} [status={status}; version={version}]"
    },
    "project_creation": "explicit_confirmation_required",
    "idempotency_boundary": "verified_user_and_operation_family",
    "event_stream_ordering_enabled": false,
    "record_merge_write_enabled": false,
    "project_merge_write_enabled": false,
    "canonical_export": "authorized_live_recheck",
    "double_write": false
  }
}
