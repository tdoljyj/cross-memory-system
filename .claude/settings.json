{
  "permissions": {
    "allow": [
      "mcp__Clued__clued_session_resume",
      "mcp__Clued__clued_session_reconcile",
      "mcp__Clued__clued_session_checkpoint",
      "mcp__Clued__clued_record_list",
      "mcp__Clued__clued_context",
      "mcp__Clued__clued_context_pack",
      "mcp__Clued__clued_search_context",
      "mcp__Clued__clued_read_log",
      "mcp__Clued__clued_record_mutate",
      "mcp__Clued__clued_agent_message_send",
      "mcp__Clued__clued_agent_inbox",
      "mcp__Clued__clued_work_claim",
      "mcp__Clued__clued_work_renew",
      "mcp__Clued__clued_work_release",
      "mcp__Clued__clued_work_verify"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/clued_capture_guard.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/clued_work_claim_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/clued_work_claim_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/clued_version_check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit|Agent|Workflow|mcp__.*__(create_pull_request|push_files|create_or_update_file|actions_run_trigger|create_session)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/clued_work_claim_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__clued_work_(claim|renew|takeover|release)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/clued_work_claim_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__clued_session_resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/clued_version_check.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/clued_work_claim_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
