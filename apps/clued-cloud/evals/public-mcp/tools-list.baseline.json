          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "request_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "description": "Structured Clued result. Tool-specific fields are versioned by the Canonical Store contract.",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "clued/requiredScopes": [
          "context:write"
        ],
        "clued/scopeEnforcement": "server-side"
      }
    },
    {
      "name": "clued_event_append",
      "description": "Append an authorized extension Event without mutating a business entity; built-in business Event types are server-only. Required Clued scope: context:write.",
      "inputSchema": {
        "type": "object",
        "required": [
          "event_schema_version",
          "event_type",
          "event_scope",
          "idempotency_key"
        ],
        "properties": {
          "event_schema_version": {
            "type": "integer",
            "const": 1
          },
          "event_type": {
            "type": "string",
            "pattern": "^extension:[a-z0-9_.-]+:[a-z0-9_.-]+$"
          },
          "event_scope": {
            "type": "string",
            "pattern": "^(profile|global|project:[0-9a-fA-F-]{36})$"
          },
          "target_refs": {
            "type": "array"
          },
          "change_summary": {
            "anyOf": [
              {
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "audit_visibility": {
            "type": "string",
            "enum": [
              "audit_only",
              "work_log"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "artifact_refs": {
            "type": "array"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "request_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "description": "Structured Clued result. Tool-specific fields are versioned by the Canonical Store contract.",
        "additionalProperties": true
