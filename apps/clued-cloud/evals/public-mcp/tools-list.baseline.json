      "description": "List the user's canonical projects, independently filtering certainty and work progress. Dismissed and merged records are hidden by default. Required Clued scope: context:read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "certainty_status": {
            "type": "string",
            "enum": [
              "unconfirmed",
              "confirmed"
            ]
          },
          "progress_status": {
            "type": "string",
            "enum": [
              "not_started",
              "active",
              "paused",
              "completed",
              "archived"
            ]
          },
          "include_dismissed": {
            "type": "boolean",
            "default": false
          },
          "query": {
            "type": "string",
            "maxLength": 120
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 100
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "description": "Structured Clued result. Tool-specific fields are versioned by the Canonical Store contract.",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "clued/requiredScopes": [
          "context:read"
        ],
        "clued/scopeEnforcement": "server-side"
      }
    },
    {
      "name": "clued_record_list",
      "description": "Read canonical records at the Global level or for one effective project. By default, only records proven current by the shared server Currentness Core are returned; an active Event remains a separate search_context current source. Set include_history=true explicitly for historical or diagnostic records, which are not authoritative current rows. Read global priority first, then project State, Task and Decision; use Log or Archive only for history. Every view returns the same canonical id. Required Clued scope: context:read.",
      "inputSchema": {
        "type": "object",
        "required": [
          "record_type"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "global",
              "project"
            ],
            "default": "global"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "record_type": {
            "type": "string",
            "enum": [
              "note",
              "state",
              "task",
              "decision",
              "archive",
              "log"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 100
          },
          "include_history": {
            "type": "boolean",
            "default": false,
            "description": "Explicit history/diagnostic view; shadowed records are non-authoritative."
          },
          "context_key": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "description": "Structured Clued result. Tool-specific fields are versioned by the Canonical Store contract.",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "clued/requiredScopes": [
          "context:read"
        ],
        "clued/scopeEnforcement": "server-side"
      }
    },
    {
      "name": "clued_record_mutate",
      "description": "Create, update, close, restore, or explicitly reclassify one v1.6 Canonical Record with CAS, Evidence authorization, Event, and immutable Receipt. Create requires mutation, source_refs, and source_unavailable_reason; mutation.type_fields requires rationale (decision), state_kind (state), execution_bucket (task), fact_kind (profile_fact), or note_kind (note). Restore requires explicit user confirmation, a reason, and the current terminal Receipt ID. Use decision.type_fields.constraint=true for a resident constraint. Required Clued scope: context:write.",
      "inputSchema": {
        "type": "object",
        "required": [
          "operation",
          "record_type",
          "record_schema_version",
          "lifecycle_status",
          "scope",
          "idempotency_key",
          "authority",
          "confidence_reason"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "close",
              "restore",
              "reclassify_scope"
            ]
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "request_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "record_type": {
            "type": "string",
            "enum": [
              "state",
              "task",
              "decision",
              "profile_fact",
              "note"
            ]
          },
          "record_schema_version": {
            "type": "integer",
            "const": 1
          },
          "lifecycle_status": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "cancelled",
              "archived",
              "revoked"
            ]
          },
          "scope": {
            "type": "string",
            "pattern": "^(profile|global|project:[0-9a-fA-F-]{36})$"
          },
          "base_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "source_unavailable_reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "mutation": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "type_fields": {
                "type": "object"
              },
              "relations": {
                "type": "object"
              },
              "closure_summary": {
                "type": "string"
              },
              "closed_reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "reclassification_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reopen_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "terminal_receipt_id": {
            "type": "string",
            "format": "uuid"
          },
          "authority": {
            "type": "string",
            "enum": [
              "user_explicit",
              "observed",
              "inferred",
              "imported"
            ]
          },
          "user_confirmed": {
            "type": "boolean"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "description": "Structured Clued result. Tool-specific fields are versioned by the Canonical Store contract.",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "clued/requiredScopes": [
          "context:write"
        ],
        "clued/scopeEnforcement": "server-side"
      }
    },
    {
      "name": "clued_decision_supersede",
