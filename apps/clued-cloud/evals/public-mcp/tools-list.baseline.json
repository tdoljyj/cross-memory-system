{
  "tools": [
    {
      "name": "clued_agent_bootstrap",
      "description": "Read the public, vendor-neutral Clued Continuity connection and lifecycle contract. This call never returns user context or credentials. Public metadata call; no authenticated Clued scope is required.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "description": "Structured Clued result. Tool-specific fields are versioned by the Canonical Store contract.",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "clued/requiredScopes": [],
        "clued/scopeEnforcement": "server-side"
      }
    },
    {
      "name": "clued_session_resume",
      "description": "Call at the start of every authorized session. Restores the latest canonical Clued checkpoint plus subsequent events, provenance, version and the next expected action. Required Clued scope: context:read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "context_key": {
            "type": "string",
            "description": "Stable project or workspace key. Defaults to global."
          },
          "client_session_id": {
            "type": "string",
            "description": "Optional vendor session id for audit correlation; never a user message."
          },
          "response_view": {
            "type": "string",
            "enum": [
              "structured",
              "work_log"
            ],
            "default": "structured",
            "description": "Choose structured pending events or the rendered work log; the response never duplicates both."
          },
          "event_cursor": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "event_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          },
          "event_budget_bytes": {
            "type": "integer",
            "minimum": 4096,
            "maximum": 262144,
            "default": 65536
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "description": "Structured Clued result. Tool-specific fields are versioned by the Canonical Store contract.",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "clued/requiredScopes": [
          "context:read"
        ],
        "clued/scopeEnforcement": "server-side"
      }
    },
    {
      "name": "clued_append_event",
      "description": "Append a durable continuity event for a decision, correction, action, failure, blocker or retracted conclusion. Use during work whenever authoritative context changes. Required Clued scope: context:write.",
      "inputSchema": {
        "type": "object",
        "required": [
          "session_token",
          "base_version",
          "event_type",
          "payload"
        ],
        "properties": {
          "context_key": {
            "type": "string"
          },
          "session_token": {
            "type": "string",
            "description": "Short-lived token returned by clued_session_resume."
          },
          "event_type": {
            "type": "string",
            "enum": [
              "decision",
              "correction",
              "action",
              "failure",
              "blocker",
              "retraction",
              "note"
            ]
          },
          "payload": {
            "type": "object"
          },
          "base_version": {
            "type": "integer",
            "minimum": 0
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "description": "Structured Clued result. Tool-specific fields are versioned by the Canonical Store contract.",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "clued/requiredScopes": [
          "context:write"
        ],
        "clued/scopeEnforcement": "server-side"
      }
    },
    {
      "name": "clued_event_carrier_transition",
      "description": "Atomically supersede, retract, or resolve one authorized active continuity Event carrier using its transition version. Supersede and retract append a separate successor Event in the same transaction; resolve requires a verified continuity-only proof receipt. The original Event remains history and never becomes a Record. Required Clued scope: context:write.",
      "inputSchema": {
        "type": "object",
        "required": [
          "context_key",
          "source_event_id",
          "expected_transition_version",
          "transition",
          "idempotency_key"
        ],
        "properties": {
          "context_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "source_event_id": {
            "type": "integer",
            "minimum": 1
          },
          "expected_transition_version": {
            "type": "integer",
            "minimum": 1
          },
          "transition": {
            "type": "string",
            "enum": [
              "supersede",
              "retract",
              "resolve"
            ]
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "session_token": {
            "type": "string",
            "description": "Required for supersede and retract successor append."
          },
          "base_version": {
            "type": "integer",
            "minimum": 0,
            "description": "Continuity CAS version for successor append."
          },
          "event_type": {
            "type": "string",
            "enum": [
              "decision",
              "correction",
              "action",
              "failure",
              "blocker"
            ]
          },
          "payload": {
            "type": "object",
            "description": "Successor Event payload for supersede or retract."
          },
          "proof_receipt_id": {
            "type": "string",
            "format": "uuid",
            "description": "Required for continuity-only resolve."
          }
        },
        "oneOf": [
          {
            "properties": {
              "transition": {
                "const": "supersede"
              }
            },
            "required": [
              "session_token",
              "base_version",
              "event_type",
              "payload"
            ]
          },
          {
            "properties": {
              "transition": {
                "const": "retract"
              }
            },
            "required": [
              "session_token",
              "base_version",
              "payload"
            ]
          },
          {
            "properties": {
              "transition": {
                "const": "resolve"
              }
            },
            "required": [
              "proof_receipt_id"
            ]
          }
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "description": "Structured Clued result. Tool-specific fields are versioned by the Canonical Store contract.",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "clued/requiredScopes": [
          "context:write"
        ],
        "clued/scopeEnforcement": "server-side"
      }
    },
    {
      "name": "clued_session_reconcile",
      "description": "Compare this authorized session with the server currentness vector and create a typed admission or observation receipt. Only an eligible result updates the session admission state; an observation does not unlock checkpointing. Required Clued scope: context:read.",
      "inputSchema": {
        "type": "object",
        "required": [
          "session_token"
