{
  "name": "clued-cloud",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:v2:red": "node --test tests/v2-red/*.test.mjs",
    "db:start": "npx --yes supabase@2.115.0 start",
    "db:reset": "npx --yes supabase@2.115.0 db reset --local --no-seed",
    "db:test:v2": "npx --yes supabase@2.115.0 test db supabase/tests/unified_record_v2.test.sql --local",
    "db:test:m1": "npx --yes supabase@2.115.0 test db supabase/tests/m1_runtime_contracts.test.sql supabase/tests/m1_legacy_mapping.test.sql --local",
    "db:lint": "npx --yes supabase@2.115.0 db lint --local --schema public,clued_private --level error --fail-on error",
    "stage5:dry-run": "node scripts/stage5-legacy-dry-run.mjs --as-of 2026-08-24T05:35:54.968159Z --source-commit a11d73c139561d61cb3a2caaf3e3280771ac5562 --db-snapshot docs/clued-two-level-views/stage5-production-readonly-snapshot.json --output docs/clued-two-level-views/stage5-legacy-dry-run.json",
    "bundle:export": "node scripts/user-memory-bundle.mjs export",
    "bundle:validate": "node scripts/user-memory-bundle.mjs validate",
    "bundle:import": "node scripts/user-memory-bundle-import.mjs",
    "snapshot:v16:build": "node scripts/two-level-snapshot.mjs build",
    "snapshot:v16:validate": "node scripts/two-level-snapshot.mjs validate",
    "snapshot:v16:publish": "node scripts/two-level-snapshot.mjs publish",
    "snapshot:v16:rollback": "node scripts/two-level-snapshot.mjs rollback",
    "snapshot:m2:enable": "node scripts/m2-snapshot-store.mjs enable --export-root ../../artifacts/clued-two-level-snapshots",
    "snapshot:m2:status": "node scripts/m2-snapshot-store.mjs status --export-root ../../artifacts/clued-two-level-snapshots",
    "snapshot:m2:reconcile": "node scripts/m2-snapshot-store.mjs reconcile --export-root ../../artifacts/clued-two-level-snapshots",
    "snapshot:m2:sweep": "node scripts/m2-snapshot-store.mjs sweep --export-root ../../artifacts/clued-two-level-snapshots",
    "snapshot:m2:publish": "node scripts/m2-snapshot-store.mjs publish --export-root ../../artifacts/clued-two-level-snapshots",
    "test:bundle": "node --test tests/user-memory-bundle.test.mjs",
    "test:snapshot:v16": "node --test tests/two-level-snapshot.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern supabase/.temp",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260823.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module",
  "displayName": "Clued"
}
