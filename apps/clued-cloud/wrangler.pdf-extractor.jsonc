{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clued-storage-pdf",
  "main": "./dist/pdf-extractor/index.js",
  "build": {
    "command": "node scripts/build-pdf-extractor.mjs"
  },
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js"] }
  ],
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 10000 },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
