{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clued-cloud",
  "main": "./dist/server/index.js",
  "build": {
    "command": "node scripts/production-release-gate.mjs --pre-deploy"
  },
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "limits": { "subrequests": 1000 },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "images": { "binding": "IMAGES" },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "d7e56a5789854d42b191333d8b545a97" }
  ],
  "services": [
    {
      "binding": "CLUED_CONNECT_SERVICE",
      "service": "clued-connect",
      "environment": "production"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
