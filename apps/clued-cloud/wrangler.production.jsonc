{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clued-cloud",
  "ratelimits": [
    { "name": "CI_RENEW_SOURCE_LIMIT", "namespace_id": "26111901", "simple": { "limit": 60, "period": 60 } },
    { "name": "CI_RENEW_IDENTITY_LIMIT", "namespace_id": "26111902", "simple": { "limit": 20, "period": 60 } }
  ],
  "routes": [
    { "pattern": "clued.pixelgrav.com", "custom_domain": true },
    { "pattern": "kooyumi.pixelgrav.com", "custom_domain": true },
    { "pattern": "kooyomi.com", "custom_domain": true }
  ],
  "vars": {
    "KOOYUMI_OAUTH_ORIGIN": "https://kooyumi.pixelgrav.com",
    "CLUED_WEB_ORIGINS": "https://kooyumi.pixelgrav.com,https://kooyomi.com,https://beamingface.com,https://dev.beamingface.com",
    "CLUED_MODEL_DOMAIN_SOURCE_V1": "true",
    "CLUED_MODEL_DOMAIN_BOOTSTRAP_REQUEST_V1": "true"
  },
  "main": "./dist/server/index.js",
  "build": {
    "command": "node scripts/verify-production-renew-rate-limits.mjs && node scripts/production-release-gate.mjs --pre-deploy"
  },
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "limits": { "subrequests": 1000 },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "images": { "binding": "IMAGES" },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "d7e56a5789854d42b191333d8b545a97" },
    { "binding": "KOOYUMI_OAUTH_KV", "id": "84dba66392314bbf82856574f85122fc" }
  ],
  "services": [
    {
      "binding": "CLUED_CONNECT_SERVICE",
      "service": "clued-connect",
      "environment": "production"
    },
    { "binding": "PDF_EXTRACTOR", "service": "clued-storage-pdf" }
  ],
  "r2_buckets": [
    { "binding": "CLUED_STORAGE_STAGING", "bucket_name": "clued-storage-staging" }
  ],
  "queues": {
    "producers": [
      { "binding": "CLUED_STORAGE_JOB_QUEUE", "queue": "clued-storage-jobs" }
    ],
    "consumers": [
      { "queue": "clued-storage-jobs", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 0 }
    ]
  },
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
